#!/usr/bin/env bash
# macOS ships bash 3.2; apps and launchd start with a minimal PATH that finds it first.
if (( BASH_VERSINFO[0] < 4 )); then
  for candidate in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    [[ -x "$candidate" ]] && exec "$candidate" "$0" "$@"
  done
  echo "slack-relay: needs bash 4 or newer (brew install bash)" >&2
  exit 1
fi
set -euo pipefail

VERSION=0.1.0
SELF="$(realpath "${BASH_SOURCE[0]}")"
ROOT="$(dirname "$(dirname "$SELF")")"
SCHEMA="$ROOT/config.schema.json"
CONFIG="${SLACK_RELAY_CONFIG:-$HOME/.config/slack-relay/config.json}"
STATE="${SLACK_RELAY_STATE:-$HOME/.local/state/slack-relay}"
INTERVAL="${SLACK_RELAY_INTERVAL:-5}"
MAX_CHARS=3500

usage() {
  cat <<'EOF'
Usage:
  slack-relay init     [--channel ID|URL] [--user ID] [--name NAME] [--token-file F] [--cookie-file F] [--force]
  slack-relay config   path | show | get <key> | set <key> <value> | unset <key> | validate
  slack-relay doctor   [--json]
  slack-relay serve
  slack-relay status   [--json]
  slack-relay spawn    <repo> <task> [--name NAME] [--runner opencode|claude|pi] [--model ID]
  slack-relay post     <id:channel> <label> <message>
  slack-relay ask      <id:channel> <label> <message> [--timeout SEC]
  slack-relay wait     <id:channel> <label> [--since TS] [--timeout SEC]
  slack-relay --version

Config: ~/.config/slack-relay/config.json (SLACK_RELAY_CONFIG). Every key and its
default is described in config.schema.json; keys use dots: dispatcher.model.
State: ~/.local/state/slack-relay (SLACK_RELAY_STATE): serve.json, serve.log,
workers/<name>.json and workers/<name>.log.

Agent posts are prefixed "<icon> [label]". Messages count only when written by
the configured user and starting with "@bot". ask/wait print the reply text and
exit 0, or exit 3 on timeout (default 3600s, 0 = forever) and print the wait
command that resumes from the same point.
EOF
}

die() { echo "slack-relay: $*" >&2; exit 1; }

# Defaults from the schema: each property's "default", or an object of its properties' defaults.
defaults_json() {
  [[ -r "$SCHEMA" ]] || die "schema missing: $SCHEMA"
  jq -c 'def d: if has("default") then .default elif .type == "object" then (.properties // {} | map_values(d)) else null end; d' "$SCHEMA"
}
DEFAULTS=$(defaults_json)

# The effective config: schema defaults deep-merged with the user's file.
config_json() {
  if [[ -r "$CONFIG" ]]; then
    jq -c --argjson d "$DEFAULTS" '$d * .' "$CONFIG"
  else
    printf '%s' "$DEFAULTS"
  fi
}

cfg() { config_json | jq -r "$1 // empty" 2>/dev/null || true; }

expand_path() { printf '%s' "${1/#\~/$HOME}"; }

ME="${SLACK_RELAY_USER:-$(cfg .user)}"
OWNER=$(cfg .name)
OWNER=${OWNER:-the user}

channel_id() {
  [[ "$1" == id:* ]] || die "channel must be id:<conversation-id>"
  printf '%s' "${1#id:}"
}

check_label() {
  [[ "$1" =~ ^[A-Za-z0-9_-]+$ ]] || die "label must be one word: letters, digits, - or _"
}

latest_ts() {
  slackc history "$1" 1 | cut -f1
}

# --- Slack Web API -----------------------------------------------------------------
# Calls go through slackc, which tests point at a fake with SLACK_RELAY_SLACK_BIN.
# Rows are "ts<TAB>id:channel<TAB>author<TAB>text<TAB>thread_ts". author is the Slack user
# ID, or "bot:<id>" for bot and webhook posts, so a display name never passes as a user.

slackc() {
  if [[ -n "${SLACK_RELAY_SLACK_BIN:-}" ]]; then
    "$SLACK_RELAY_SLACK_BIN" "$@"
    return
  fi
  local action=$1; shift
  case "$action" in
    history) slack_history "$@" ;;
    thread) slack_thread "$@" ;;
    send) slack_send "$@" ;;
    whoami) slack_api GET auth.test | jq -r '.user_id' ;;
    *) die "unknown slack action $action" ;;
  esac
}

# Writes a curl config with the credentials, so the token never shows in a process list.
slack_curl_config() {
  local token_file cookie_file token cookie=""
  token_file=$(expand_path "$(cfg .slack.token_file)")
  cookie_file=$(expand_path "$(cfg .slack.cookie_file)")
  [[ -r "$token_file" ]] || die "Slack token missing: $token_file (config slack.token_file)"
  token=$(tr -d '\r\n' <"$token_file")
  [[ -n "$token" ]] || die "Slack token file is empty: $token_file"
  [[ -z "$cookie_file" || ! -r "$cookie_file" ]] || cookie=$(tr -d '\r\n' <"$cookie_file")
  [[ "$token" != xoxc-* || -n "$cookie" ]] || die "an xoxc- token needs its d cookie: set slack.cookie_file"
  {
    printf 'header = "Authorization: Bearer %s"\n' "${token//\"/\\\"}"
    [[ -z "$cookie" ]] || printf 'cookie = "d=%s"\n' "${cookie//\"/\\\"}"
  } >"$1"
}

slack_api() {
  local method=$1 endpoint=$2 dir status error attempt
  shift 2
  dir=$(mktemp -d "${TMPDIR:-/tmp}/slack-relay-api.XXXXXX")
  (umask 077; slack_curl_config "$dir/curl.conf") || { rm -rf "$dir"; return 1; }
  local -a args=(--silent --show-error --max-time 20 --connect-timeout 10 --config "$dir/curl.conf" -o "$dir/body" -w '%{http_code}' -X "$method")
  [[ "$method" != GET ]] || args+=(-G)
  local param
  for param in "$@"; do args+=(--data-urlencode "$param"); done
  for attempt in 1 2; do
    if ! status=$("${SLACK_RELAY_CURL:-curl}" "${args[@]}" "${SLACK_RELAY_API:-https://slack.com/api}/$endpoint" 2>/dev/null); then
      rm -rf "$dir"; echo "slack-relay: Slack request failed (network?)" >&2; return 1
    fi
    if [[ "$status" =~ ^2 ]] && jq -e '.ok == true' "$dir/body" >/dev/null 2>&1; then
      cat "$dir/body"; rm -rf "$dir"; return 0
    fi
    error=$(jq -r '.error // empty' "$dir/body" 2>/dev/null || true)
    [[ ( "$status" == 429 || "$error" == ratelimited ) && $attempt == 1 ]] || break
    sleep 2
  done
  rm -rf "$dir"
  echo "slack-relay: Slack $endpoint failed: ${error:-HTTP $status}" >&2
  return 1
}

slack_rows() {
  jq -r --arg id "$1" '
    def safe: tostring | gsub("[[:cntrl:]]"; "");
    def author: if .bot_id != null or .user == null or .subtype == "bot_message"
      then "bot:" + ((.bot_id // .username // "unknown") | tostring) else .user end;
    .messages[]? | [(.ts | safe), ("id:" + $id), (author | safe), ((.text // "") | safe), ((.thread_ts // "") | safe)] | @tsv'
}

# slack_history <channel> <limit> [since]: channel messages, plus replies in threads active after since.
slack_history() {
  local id=$1 limit=$2 since=${3:-} response thread
  response=$(slack_api GET conversations.history "channel=$id" "limit=$limit") || return 1
  slack_rows "$id" <<<"$response"
  [[ -n "$since" ]] || return 0
  while IFS= read -r thread; do
    [[ "$thread" =~ ^[0-9]+\.[0-9]+$ ]] || continue
    slack_api GET conversations.replies "channel=$id" "ts=$thread" "oldest=$since" "limit=100" \
      | jq --arg t "$thread" '.messages |= map(select(.ts != $t))' | slack_rows "$id"
  done < <(jq -r --arg s "$since" '.messages[]? | select(.latest_reply != null and (.latest_reply | tonumber) > ($s | tonumber)) | .ts' <<<"$response")
}

# slack_thread <channel> <thread_ts> <limit>: the whole thread, parent first.
slack_thread() {
  slack_api GET conversations.replies "channel=$1" "ts=$2" "limit=$3" | slack_rows "$1"
}

# slack_send <channel> <text> [thread_ts]
slack_send() {
  local -a params=("channel=$1" "text=$2")
  [[ -z "${3:-}" || "$3" == - ]] || params+=("thread_ts=$3")
  slack_api POST chat.postMessage "${params[@]}" >/dev/null
}

# Rewrites common Markdown into Slack mrkdwn, so a model's habits don't leak into posts,
# and links every Jira key of a configured project that is not already inside a link.
slackify() {
  local jira projects
  jira=$(cfg .jira_url)
  projects=$(config_json | jq -r '(.jira_projects // []) | map(select(test("^[A-Z][A-Z0-9]+$"))) | join("|")' 2>/dev/null || true)
  sed -E \
    -e 's/\*\*([^*]+)\*\*/*\1*/g' \
    -e 's/\[([^]]+)\]\((https?:[^)]+)\)/<\2|\1>/g' \
    -e 's/^#{1,6}[[:space:]]+(.*)$/*\1*/' \
    -e 's#(^|[^<|])(https://[A-Za-z0-9.-]+\.atlassian\.net/browse/([A-Z][A-Z0-9]+-[0-9]+))#\1<\2|\3>#g' \
    | if [[ -n "$jira" && -n "$projects" ]]; then
        JIRA="${jira%/}" perl -pe 's{(<[^>]*>)|\b((?:'"$projects"')-\d+)\b}{defined $1 ? $1 : "<$ENV{JIRA}/browse/$2|$2>"}ge'
      else
        cat
      fi
}

# Posts to the channel, or into SLACK_RELAY_THREAD when set.
post() {
  slackc send "$1" "$(cfg .icon) [$2] $(slackify <<<"$3")" "${SLACK_RELAY_THREAD:--}" >/dev/null
}

# Prints "ts<TAB>label<TAB>thread<TAB>text" for each message from ME after <since>, in the
# channel or any thread, oldest first. label is "." when the message does not start with
# "@bot", and "@" when no name follows it; thread and an empty text are "-".
messages_after() {
  local id=$1 since=$2
  slackc history "$id" 50 "$since" \
    | awk -F'\t' -v since="$since" -v me="$ME" '($1 "") > (since "") && $3 == me' \
    | sort -t$'\t' -k1,1 -u \
    | while IFS=$'\t' read -r ts _ _ text thread; do
        [[ -n "$thread" && "$thread" != "$ts" ]] || thread=-
        if [[ ! "$text" =~ ^@[Bb][Oo][Tt]([[:space:]:,]+(.*))?$ ]]; then
          printf '%s\t.\t%s\t-\n' "$ts" "$thread"
          continue
        fi
        local rest=${BASH_REMATCH[2]} label=@ body
        body=$rest
        if [[ "$rest" =~ ^([A-Za-z0-9_-]+)([[:space:]:,]+(.*))?$ ]]; then
          label=${BASH_REMATCH[1]}
          body=${BASH_REMATCH[3]}
        fi
        body=${body//&lt;/<}
        body=${body//&gt;/>}
        body=${body//&amp;/\&}
        printf '%s\t%s\t%s\t%s\n' "$ts" "$label" "$thread" "${body:--}"
      done
}

worker_file() { printf '%s/workers/%s.json' "$STATE" "$1"; }

set_state() {
  local file tmp
  file=$(worker_file "$1"); shift
  tmp=$(mktemp "$file.XXXXXX")
  jq "$@" "$file" >"$tmp" && mv "$tmp" "$file"
}

# running | waiting | done | failed | died | none
worker_status() {
  local file status pid
  file=$(worker_file "$1")
  [[ -f "$file" ]] || { echo none; return; }
  status=$(jq -r '.status' "$file")
  pid=$(jq -r '.pid // 0' "$file")
  if [[ "$status" == running || "$status" == waiting ]] && ! kill -0 "$pid" 2>/dev/null; then
    echo died
  else
    echo "$status"
  fi
}

wait_reply() {
  local id=$1 label=$2 since=$3 timeout=$4 start=$SECONDS line
  label=$(tr '[:upper:]' '[:lower:]' <<<"$label")
  while :; do
    line=$(messages_after "$id" "$since" | awk -F'\t' -v l="$label" 'tolower($2) == l' | head -n 1)
    if [[ -n "$line" ]]; then
      local ts _label _thread text
      IFS=$'\t' read -r ts _label _thread text <<<"$line"
      [[ "$text" != - ]] || text=""
      printf '%s\n' "$text"
      if [[ -n "${SLACK_RELAY_WORKER:-}" && -f "$(worker_file "$SLACK_RELAY_WORKER")" ]]; then
        set_state "$SLACK_RELAY_WORKER" --arg ts "$ts" '.answered_ts = $ts | .status = "running"'
      fi
      return 0
    fi
    if (( timeout > 0 && SECONDS - start >= timeout )); then
      echo "slack-relay: no reply for [$label] after ${timeout}s. Keep waiting: slack-relay wait id:$id $label --since $since --timeout $timeout" >&2
      return 3
    fi
    sleep "$INTERVAL"
  done
}

parse_timeout() {
  [[ "$1" =~ ^[0-9]+$ ]] || die "--timeout needs seconds"
  printf '%s' "$1"
}

# Runs one agent turn and prints its final text reply.
# resume=true continues an existing session; claude needs --resume there instead of --session-id.
run_agent() {
  local runner=$1 workdir=$2 session=$3 resume=$4 model=$5 auto=$6 title=$7 prompt=$8 out err
  local -a cmd
  case "$runner" in
    opencode)
      cmd=(opencode run --format json --title "$title")
      [[ -z "$session" ]] || cmd+=(--session "$session")
      [[ "$auto" != true ]] || cmd+=(--auto)
      ;;
    claude)
      cmd=(claude -p --output-format json)
      if [[ -n "$session" && "$resume" == true ]]; then
        cmd+=(--resume "$session")
      elif [[ -n "$session" ]]; then
        cmd+=(--session-id "$session")
      fi
      [[ "$auto" != true ]] || cmd+=(--dangerously-skip-permissions)
      ;;
    pi)
      # pi -p runs tools without asking, so auto has no effect
      cmd=(pi -p)
      if [[ -n "$session" ]]; then cmd+=(--session-id "$session"); else cmd+=(--no-session); fi
      ;;
    *)
      printf 'error: unknown runner "%s" (use opencode, claude, or pi)' "$runner"
      return 1
      ;;
  esac
  [[ -z "$model" ]] || cmd+=(--model "$model")
  err=$(mktemp "${TMPDIR:-/tmp}/slack-relay.XXXXXX")
  # stdin must not be a pipe, or the agent CLI waits for EOF forever
  if ! out=$(cd "$workdir" && "${cmd[@]}" "$prompt" </dev/null 2>"$err"); then
    printf 'error: %s' "$(tail -n 5 "$err")"
    rm -f "$err"
    return 1
  fi
  rm -f "$err"
  case "$runner" in
    opencode) out=$(jq -rs '[.[] | select(.type == "text") | .part.text] | last // empty' <<<"$out" 2>/dev/null || true) ;;
    claude)
      if [[ "$(jq -r '.is_error // false' <<<"$out" 2>/dev/null)" == true ]]; then
        printf 'error: %s' "$(jq -r '.result // "claude failed"' <<<"$out")"
        return 1
      fi
      out=$(jq -r '.result // empty' <<<"$out" 2>/dev/null || true)
      ;;
  esac
  printf '%s' "${out:-(finished with no text reply)}"
}

new_session_id() {
  local runner=$1 name=${2//-/_}
  case "$runner" in
    claude) uuidgen | tr '[:upper:]' '[:lower:]' ;;
    pi) printf 'slack_%s_%s' "$name" "$(date +%s)" ;;
    *) printf 'ses_slack_%s_%s' "$name" "$(date +%s)" ;;
  esac
}

clip() {
  local text=$1
  (( ${#text} <= MAX_CHARS )) || text="${text:0:MAX_CHARS}… (truncated)"
  printf '%s' "$text"
}

command_post() {
  [[ $# -eq 3 ]] || { usage >&2; exit 2; }
  local id; id=$(channel_id "$1"); check_label "$2"
  [[ -n "$3" ]] || die "message must not be empty"
  post "$id" "$2" "$3"
  echo "posted [$2]"
}

command_ask() {
  [[ $# -ge 3 ]] || { usage >&2; exit 2; }
  local id label=$2 message=$3 timeout=3600 since
  id=$(channel_id "$1"); check_label "$label"
  shift 3
  while (( $# )); do
    case "$1" in
      --timeout) timeout=$(parse_timeout "${2:-}"); shift 2 ;;
      *) usage >&2; exit 2 ;;
    esac
  done
  since=$(latest_ts "$id")
  [[ "$since" =~ ^[0-9]+(\.[0-9]+)?$ ]] || die "cannot read channel $id"
  post "$id" "$label" "$message"
  if [[ -n "${SLACK_RELAY_WORKER:-}" && -f "$(worker_file "$SLACK_RELAY_WORKER")" ]]; then
    set_state "$SLACK_RELAY_WORKER" '.status = "waiting"'
  fi
  wait_reply "$id" "$label" "$since" "$timeout"
}

command_wait() {
  [[ $# -ge 2 ]] || { usage >&2; exit 2; }
  local id label=$2 timeout=3600 since=""
  id=$(channel_id "$1"); check_label "$label"
  shift 2
  while (( $# )); do
    case "$1" in
      --since) since=${2:-}; shift 2 ;;
      --timeout) timeout=$(parse_timeout "${2:-}"); shift 2 ;;
      *) usage >&2; exit 2 ;;
    esac
  done
  [[ -n "$since" ]] || since=$(latest_ts "$id")
  [[ "$since" =~ ^[0-9]+(\.[0-9]+)?$ ]] || die "cannot read channel $id"
  wait_reply "$id" "$label" "$since" "$timeout"
}

command_status() {
  local file name status
  shopt -s nullglob
  local files=("$STATE"/workers/*.json)
  (( ${#files[@]} )) || { echo "no workers"; return; }
  for file in "${files[@]}"; do
    name=$(basename "$file" .json)
    status=$(worker_status "$name")
    jq -r --arg s "$status" '[.name, $s, .repo, (.task | gsub("\\s+"; " ") | .[0:80])] | @tsv' "$file"
  done
}

start_worker() {
  local name=$1 prompt=$2 pid
  nohup "$SELF" _work "$name" "$prompt" >>"$STATE/workers/$name.log" 2>&1 </dev/null &
  pid=$!
  disown "$pid" 2>/dev/null || true
  set_state "$name" --argjson pid "$pid" '.pid = $pid | .status = "running"'
}

link_rule() {
  local jira
  jira=$(cfg .jira_url)
  printf '%s\n%s' "- Link everything you mention, so they can tap it on their phone: CircleCI jobs and pipelines (their https://app.circleci.com/pipelines/... URL), GitHub PRs, commits and files, dashboards. Write each link as a Slack link with a short label, never a bare URL: <https://github.com/org/repo/pull/12|PR #12>, <https://app.circleci.com/pipelines/...|library-check job>.${jira:+ Write Jira keys plainly (ADE-123), once: they become links automatically.}" \
    "- Format for Slack: *bold*, _italic_, \`code\`, plain - bullets. Slack does not render **double asterisks**, # headings, or tables."
}

worker_prompt() {
  local name=$1 task=$2 channel
  channel=$(cfg .channel)
  cat <<EOF
$OWNER started you from Slack as worker "$name". They are away from the Mac and read Slack on their phone.
- When you need a decision, run this and treat the printed text as their answer. On exit 3 they have not answered yet: run the \`slack-relay wait …\` command it printed on stderr, and repeat.
  slack-relay ask id:$channel $name "<question>. reply: @bot $name …" --timeout 540
- Your final message is posted to Slack for you. Keep it short: what changed, where, and what is left.
$(link_rule)
- Leave commits, pushes, and PRs for them to ask for.

Task: $task
EOF
}

command_spawn() {
  [[ $# -ge 2 ]] || { usage >&2; exit 2; }
  local repo=$1 task=$2 name="" runner="" model="" dir n=2 session
  shift 2
  while (( $# )); do
    case "$1" in
      --name) name=${2:-}; shift 2 ;;
      --runner) runner=${2:-}; shift 2 ;;
      --model) model=${2:-}; shift 2 ;;
      *) usage >&2; exit 2 ;;
    esac
  done
  [[ -r "$CONFIG" ]] || die "missing $CONFIG; run: slack-relay init"
  runner=${runner:-$(cfg .worker.runner)}
  case "$runner" in opencode|claude|pi) ;; *) die "unknown runner '$runner' (use opencode, claude, or pi)" ;; esac
  model=${model:-$(cfg ".worker.models.$runner")}
  dir=$(cfg ".repos[\"$repo\"]")
  [[ -n "$dir" ]] || die "unknown repo '$repo'; known: $(config_json | jq -r '.repos | keys | join(", ")')"
  dir=$(expand_path "$dir")
  [[ -d "$dir" ]] || die "repo dir missing: $dir"
  name=$(tr '[:upper:]' '[:lower:]' <<<"${name:-$repo}")
  check_label "$name"
  local base=$name
  while [[ "$(worker_status "$name")" == running || "$(worker_status "$name")" == waiting || "$name" == "$(cfg .dispatcher.label)" ]]; do
    name="$base-$n"; n=$((n + 1))
  done
  session=$(new_session_id "$runner" "$name")
  mkdir -p "$STATE/workers"
  jq -n --arg name "$name" --arg repo "$repo" --arg dir "$dir" --arg runner "$runner" --arg model "$model" \
    --arg session "$session" --arg task "$task" --arg started "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg thread "${SLACK_RELAY_THREAD:--}" \
    '{name: $name, repo: $repo, dir: $dir, runner: $runner, model: $model, session: $session, thread: $thread, turns: 0, task: $task, started: $started, status: "running", pid: 0}' \
    >"$(worker_file "$name")"
  start_worker "$name" "$(worker_prompt "$name" "$task")"
  echo "started [$name] in $dir ($runner session $session)"
}

command_work() {
  local name=$1 prompt=$2 file dir runner model session resume=false auto answer status=done
  file=$(worker_file "$name")
  dir=$(jq -r .dir "$file")
  runner=$(jq -r '.runner // "opencode"' "$file")
  model=$(jq -r '.model // ""' "$file")
  session=$(jq -r .session "$file")
  [[ "$(jq -r '.turns // 0' "$file")" == 0 ]] || resume=true
  auto=$(cfg .worker.auto)
  export SLACK_RELAY_WORKER=$name
  SLACK_RELAY_THREAD=$(jq -r '.thread // "-"' "$file")
  export SLACK_RELAY_THREAD
  answer=$(run_agent "$runner" "$dir" "$session" "$resume" "$model" "$auto" "slack: $name" "$prompt") || status=failed
  post "$(cfg .channel)" "$name" "$(clip "$answer")"
  set_state "$name" --arg s "$status" --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '.status = $s | .finished = $t | .turns += 1'
}

dispatch() {
  local id=$1 label=$2 ts=$3 text=$4 workdir runner model auto memory answer thread_context="" thread=${SLACK_RELAY_THREAD:--}
  if [[ "$thread" != - ]]; then
    thread_context=$(slackc thread "$id" "$thread" 50 \
      | awk -F'\t' -v ts="$ts" -v me="$ME" '($1 "") < (ts "") && $3 == me { print "- " $4 }' | tail -n 30 \
      | sed -e 's/&lt;/</g' -e 's/&gt;/>/g' -e 's/&amp;/\&/g') || thread_context=""
    (( ${#thread_context} <= 4000 )) || thread_context="…${thread_context: -4000}"
  fi
  workdir=$(expand_path "$(cfg .dispatcher.workdir)")
  mkdir -p "$workdir"
  [[ -f "$workdir/MEMORY.md" ]] || : >"$workdir/MEMORY.md"
  runner=$(cfg .dispatcher.runner)
  model=$(cfg .dispatcher.model)
  auto=$(cfg .dispatcher.auto)
  memory=$(cat "$workdir/MEMORY.md")
  answer=$(run_agent "$runner" "$workdir" "" false "$model" "$auto" "slack: $label" "$(cat <<EOF
You are "$label", $OWNER's dispatcher on their Mac. They write from Slack on their phone. Every message starts a fresh session, so MEMORY.md is all you remember.
- Answer in a few lines.
$(link_rule)
- For real work in a repo, start a worker instead of doing it yourself, with a self-contained task:
  slack-relay spawn <repo> "<task>"
  Add --runner claude, --runner opencode, or --runner pi when they name a tool (default: $(cfg .worker.runner)). Add --model <id> only when they name a model.
  Then tell them the worker name it printed; they talk to it with @bot <name>.
- Repos: $(config_json | jq -r '.repos | to_entries | map("\(.key)=\(.value)") | join(", ")')
- Workers (name, status, repo, task):
$(command_status | sed 's/^/  /')
- MEMORY.md ($workdir/MEMORY.md) holds their standing notes. Edit it only when they ask you to remember or forget something, and keep it under $(cfg .dispatcher.memory_lines) lines.

MEMORY.md:
${memory:-(empty)}
${thread_context:+
They wrote this in a Slack thread. Earlier messages in it, oldest first (all from their account; lines starting with the icon are agent posts):
$thread_context
}
Message from $OWNER: $text
EOF
)") || true
  post "$id" "$label" "$(clip "$answer")"
}

route() {
  local id=$1 dispatcher=$2 ts=$3 label=$4 text=$5 name status answered
  name=$(tr '[:upper:]' '[:lower:]' <<<"$label")
  if [[ "$label" == @ ]]; then
    name=$dispatcher
  elif [[ "$name" != "$dispatcher" && "$(worker_status "$name")" == none ]]; then
    text="$label${text:+ $text}"
    name=$dispatcher
  fi
  if [[ "$name" == "$dispatcher" ]]; then
    [[ -n "$text" ]] || return 0
    echo "[$(date +%T)] [$name] in: $text" >&2
    dispatch "$id" "$name" "$ts" "$text"
    return
  fi
  label=$name
  status=$(worker_status "$label")
  case "$status" in
    waiting)
      ;;
    running)
      answered=$(jq -r '.answered_ts // ""' "$(worker_file "$label")")
      [[ -n "$answered" && ! "$ts" > "$answered" ]] \
        || post "$id" "$label" "Still working. I only read replies after I ask a question."
      ;;
    *)
      [[ -n "$text" ]] || return 0
      echo "[$(date +%T)] [$label] resume: $text" >&2
      set_state "$label" --arg thread "${SLACK_RELAY_THREAD:--}" '.thread = $thread'
      start_worker "$label" "$text"
      post "$id" "$label" "picked it up…"
      ;;
  esac
}

command_serve() {
  [[ -r "$CONFIG" ]] || die "missing $CONFIG; run: slack-relay init"
  config_errors | sed 's/^/config: /' >&2
  [[ -z "$(config_errors)" ]] || die "fix the config first: slack-relay config validate"
  local id dispatcher since
  id=$(cfg .channel)
  [[ "$id" =~ ^[A-Z0-9]+$ ]] || die "config .channel must be a conversation ID like C0123456789"
  dispatcher=$(cfg .dispatcher.label)
  dispatcher=$(tr '[:upper:]' '[:lower:]' <<<"$dispatcher")
  mkdir -p "$STATE/workers"
  local serve_file="$STATE/serve.json" other owner
  other=$(serve_json | jq -r 'select(.running) | .pid')
  [[ -z "$other" || "$other" == "$$" ]] || die "already running (pid $other)"
  owner=$(slackc whoami) || die "cannot reach Slack; run: slack-relay doctor"
  [[ "$owner" == "$ME" ]] || die "the Slack token belongs to $owner, not the configured user $ME"
  since=${SLACK_RELAY_SINCE:-$(latest_ts "$id")}
  [[ "$since" =~ ^[0-9]+(\.[0-9]+)?$ ]] || die "cannot read channel $id; run: slack-relay doctor"
  jq -n --argjson pid $$ --arg channel "$id" --arg dispatcher "$dispatcher" --arg started "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{pid: $pid, channel: $channel, dispatcher: $dispatcher, started: $started, last_poll: null}' >"$serve_file"
  echo "serve: channel=$id dispatcher=[$dispatcher] state=$STATE" >&2
  while :; do
    while IFS=$'\t' read -r ts label thread text; do
      since=$ts
      [[ "$label" != . ]] || continue
      [[ "$text" != - ]] || text=""
      export SLACK_RELAY_THREAD=$thread
      route "$id" "$dispatcher" "$ts" "$label" "$text"
    done < <(messages_after "$id" "$since")
    jq --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '.last_poll = $t' "$serve_file" >"$serve_file.tmp" && mv "$serve_file.tmp" "$serve_file"
    [[ "${SLACK_RELAY_ONCE:-0}" != 1 ]] || break
    sleep "$INTERVAL"
  done
}

require_user() {
  [[ -n "$ME" ]] || die "no Slack user configured; run: slack-relay config set user U0123456789"
}

normalize_channel() {
  local value=$1
  [[ "$value" =~ /archives/([A-Z0-9]+) ]] && value=${BASH_REMATCH[1]}
  printf '%s' "${value#id:}"
}

# Prints one "<key>: <problem>" line per invalid setting in the effective config.
config_errors() {
  if [[ -e "$CONFIG" ]] && ! jq empty "$CONFIG" 2>/dev/null; then
    echo "config: $CONFIG is not valid JSON"
    return
  fi
  config_json | jq -r '
    def re($p): type == "string" and test($p);
    def runner: IN("opencode", "claude", "pi");
    (if .channel | re("^[CDG][A-Z0-9]{8,}$") then empty else "channel: Slack conversation ID like C0123456789, or the channel link (now \(.channel | tojson))" end),
    (if .user | re("^[UW][A-Z0-9]{8,}$") then empty else "user: your Slack member ID like U0123456789 (now \(.user | tojson))" end),
    (if .name | type == "string" then empty else "name: text" end),
    (if .icon | re(".") then empty else "icon: an emoji like :robot_face:" end),
    (if .slack.token_file | re(".") then empty else "slack.token_file: path to your Slack token file" end),
    (if .slack.cookie_file | type == "string" then empty else "slack.cookie_file: path, or empty for xoxp- tokens" end),
    (if .jira_url == "" or (.jira_url | re("^https://")) then empty else "jira_url: https:// address or empty" end),
    (if (.jira_projects | type) == "array" and all(.jira_projects[]; re("^[A-Z][A-Z0-9]+$")) then empty else "jira_projects: list of project keys like [\"ADE\"]" end),
    (if .dispatcher.label | re("^[a-z0-9_-]+$") then empty else "dispatcher.label: one lowercase word" end),
    (if .dispatcher.runner | runner then empty else "dispatcher.runner: opencode, claude, or pi" end),
    (if .dispatcher.model | type == "string" then empty else "dispatcher.model: text, empty for the runner default" end),
    (if .dispatcher.workdir | re(".") then empty else "dispatcher.workdir: a folder path" end),
    (if (.dispatcher.auto | type) == "boolean" then empty else "dispatcher.auto: true or false" end),
    (if (.dispatcher.memory_lines | type) == "number" and .dispatcher.memory_lines >= 1 then empty else "dispatcher.memory_lines: a number of lines, 1 or more" end),
    (if .worker.runner | runner then empty else "worker.runner: opencode, claude, or pi" end),
    (if (.worker.models | type) == "object" and all(.worker.models[]; type == "string") then empty else "worker.models: model per runner, e.g. {\"claude\": \"sonnet\"}" end),
    (if (.worker.auto | type) == "boolean" then empty else "worker.auto: true or false" end),
    (if (.repos | type) == "object" and all(.repos | to_entries[]; (.key | test("^[a-z0-9_-]+$")) and (.value | re("."))) then empty else "repos: map of one-word lowercase name to folder path" end)
  '
}

command_init() {
  local channel="" user="" name="" token_file="" cookie_file="" force=false
  while (( $# )); do
    case "$1" in
      --channel) channel=$(normalize_channel "${2:-}"); shift 2 ;;
      --user) user=${2:-}; shift 2 ;;
      --name) name=${2:-}; shift 2 ;;
      --token-file) token_file=${2:-}; shift 2 ;;
      --cookie-file) cookie_file=${2:-}; shift 2 ;;
      --force) force=true; shift ;;
      *) usage >&2; exit 2 ;;
    esac
  done
  [[ ! -e "$CONFIG" || "$force" == true ]] || die "$CONFIG exists; change it with slack-relay config set, or rerun with --force"
  mkdir -p "$(dirname "$CONFIG")"
  jq -n --argjson d "$DEFAULTS" --arg c "$channel" --arg u "$user" --arg n "$name" --arg t "$token_file" --arg k "$cookie_file" \
    '$d | .channel = $c | .user = $u | .name = $n
       | if $t != "" then .slack.token_file = $t else . end
       | if $k != "" then .slack.cookie_file = $k else . end' >"$CONFIG"
  echo "wrote $CONFIG"
  if [[ -z "$user" ]] && user=$(slackc whoami 2>/dev/null) && [[ -n "$user" ]]; then
    command_config set user "$user" >/dev/null
    echo "user = $user (from the Slack token)"
  fi
  local errors
  errors=$(config_errors)
  [[ -z "$errors" ]] || { echo "still to set:"; sed 's/^/  /' <<<"$errors"; }
}

key_path() {
  [[ "$1" =~ ^[a-z_]+(\.[A-Za-z0-9_-]+)*$ ]] || die "key must look like dispatcher.model"
  jq -nc --arg k "$1" '$k | split(".")'
}

command_config() {
  local action=${1:-show} key path value tmp errors
  case "$action" in
    path) echo "$CONFIG" ;;
    show) config_json | jq . ;;
    get)
      [[ $# -eq 2 ]] || { usage >&2; exit 2; }
      path=$(key_path "$2")
      config_json | jq -r --argjson p "$path" 'getpath($p) | if type == "string" then . else tojson end'
      ;;
    set|unset)
      [[ ( "$action" == set && $# -eq 3 ) || ( "$action" == unset && $# -eq 2 ) ]] || { usage >&2; exit 2; }
      key=$2
      path=$(key_path "$key")
      mkdir -p "$(dirname "$CONFIG")"
      [[ -e "$CONFIG" ]] || echo '{}' >"$CONFIG"
      tmp=$(mktemp "$CONFIG.XXXXXX")
      if [[ "$action" == set ]]; then
        value=$3
        [[ "$key" != channel ]] || value=$(normalize_channel "$value")
        # JSON when it parses (true, 200, ["ADE"]), text otherwise
        jq -e . >/dev/null 2>&1 <<<"$value" && value=$(jq -c . <<<"$value") || value=$(jq -nc --arg v "$value" '$v')
        jq --argjson p "$path" --argjson v "$value" 'setpath($p; $v)' "$CONFIG" >"$tmp"
      else
        jq --argjson p "$path" 'delpaths([$p])' "$CONFIG" >"$tmp"
      fi
      errors=$(CONFIG=$tmp config_errors | grep -E "^${key//./\\.}[:.]" || true)
      if [[ -n "$errors" ]]; then
        rm -f "$tmp"
        die "not saved: $errors"
      fi
      mv "$tmp" "$CONFIG"
      echo "$key = $(command_config get "$key")"
      ;;
    validate)
      errors=$(config_errors)
      [[ -z "$errors" ]] || { echo "$errors"; exit 1; }
      echo "config ok: $CONFIG"
      ;;
    *) usage >&2; exit 2 ;;
  esac
}

serve_json() {
  local file="$STATE/serve.json" pid
  [[ -f "$file" ]] || { echo '{"running": false}'; return; }
  pid=$(jq -r '.pid // 0' "$file")
  if kill -0 "$pid" 2>/dev/null; then
    jq -c '. + {running: true}' "$file"
  else
    jq -c '. + {running: false}' "$file"
  fi
}

command_doctor() {
  local json=false checks="[]" runner dir name
  [[ "${1:-}" != --json ]] || json=true
  check() { checks=$(jq -c --arg c "$1" --argjson ok "$2" --arg d "$3" '. + [{check: $c, ok: $ok, detail: $d}]' <<<"$checks"); }
  for tool in curl jq perl; do
    if command -v "$tool" >/dev/null; then check "$tool installed" true "$(command -v "$tool")"; else check "$tool installed" false "not on PATH"; fi
  done
  if [[ -r "$CONFIG" ]]; then check "config file" true "$CONFIG"; else check "config file" false "missing; run: slack-relay init"; fi
  local errors
  errors=$(config_errors)
  if [[ -z "$errors" ]]; then check "config valid" true ""; else check "config valid" false "$(paste -sd ';' - <<<"$errors")"; fi
  local owner
  if owner=$(slackc whoami 2>&1); then
    if [[ "$owner" == "$ME" ]]; then check "slack login" true "token belongs to $owner"
    else check "slack login" false "token belongs to $owner, not the configured user ${ME:-(unset)}"; fi
  else
    check "slack login" false "$owner"
  fi
  if [[ -n "$(cfg .channel)" ]] && slackc history "$(cfg .channel)" 1 >/dev/null 2>&1; then
    check "channel readable" true "$(cfg .channel)"
  else
    check "channel readable" false "cannot read channel $(cfg .channel)"
  fi
  for runner in $(printf '%s\n' "$(cfg .dispatcher.runner)" "$(cfg .worker.runner)" | sort -u); do
    if command -v "$runner" >/dev/null; then check "$runner installed" true "$(command -v "$runner")"; else check "$runner installed" false "runner $runner not on PATH"; fi
  done
  while IFS=$'\t' read -r name dir; do
    [[ -n "$name" ]] || continue
    dir=$(expand_path "$dir")
    if [[ -d "$dir" ]]; then check "repo $name" true "$dir"; else check "repo $name" false "missing folder $dir"; fi
  done < <(config_json | jq -r '.repos | to_entries[] | [.key, .value] | @tsv')
  if [[ "$(serve_json | jq -r .running)" == true ]]; then
    check "serve" true "running, pid $(serve_json | jq -r .pid)"
  else
    check "serve" true "not running; start with: slack-relay serve"
  fi
  if [[ "$json" == true ]]; then
    jq . <<<"$checks"
  else
    jq -r '.[] | "\(if .ok then "ok  " else "FAIL" end)  \(.check)\(if .detail == "" then "" else ": \(.detail)" end)"' <<<"$checks"
  fi
  [[ "$(jq '[.[] | select(.ok | not)] | length' <<<"$checks")" == 0 ]]
}

command_status_json() {
  local file name workers="[]"
  shopt -s nullglob
  for file in "$STATE"/workers/*.json; do
    name=$(basename "$file" .json)
    workers=$(jq -c --slurpfile w "$file" --arg s "$(worker_status "$name")" '. + [$w[0] + {status: $s}]' <<<"$workers")
  done
  jq -n --argjson serve "$(serve_json)" --argjson workers "$workers" '{serve: $serve, workers: $workers}'
}

case ${1:-} in
  init) shift; command_init "$@" ;;
  config) shift; command_config "$@" ;;
  doctor) shift; command_doctor "$@" ;;
  post) shift; command_post "$@" ;;
  ask) shift; require_user; command_ask "$@" ;;
  wait) shift; require_user; command_wait "$@" ;;
  serve) shift; require_user; command_serve "$@" ;;
  spawn) shift; command_spawn "$@" ;;
  status) shift; if [[ "${1:-}" == --json ]]; then command_status_json; else command_status "$@"; fi ;;
  _work) shift; command_work "$@" ;;
  _slack) shift; slackc "$@" ;;
  -v|--version|version) echo "slack-relay $VERSION" ;;
  -h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
