#!/usr/bin/env bash
# macOS ships bash 3.2; apps and launchd start with a minimal PATH that finds it first.
if (( BASH_VERSINFO[0] < 4 )); then
  for candidate in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    [[ -x "$candidate" ]] && exec "$candidate" "$0" "$@"
  done
  echo "slack-relay: needs bash 4 or newer (brew install bash)" >&2
  exit 1
fi
set -euo pipefail

VERSION=0.1.0
SELF="$(realpath "${BASH_SOURCE[0]}")"
ROOT="$(dirname "$(dirname "$SELF")")"
SCHEMA="$ROOT/config.schema.json"
CONFIG="${SLACK_RELAY_CONFIG:-$HOME/.config/slack-relay/config.json}"
STATE="${SLACK_RELAY_STATE:-$HOME/.local/state/slack-relay}"
INTERVAL="${SLACK_RELAY_INTERVAL:-5}"
MAX_CHARS=3500

usage() {
  cat <<'EOF'
Usage:
  slack-relay init     [--channel ID|URL] [--user ID] [--name NAME] [--token-file F] [--cookie-file F] [--force]
  slack-relay config   path | show | schema | fields --json | get <key> | set <key> <value> | unset <key> | apply | validate
  slack-relay doctor   [--json]
  slack-relay serve
  slack-relay start | stop
  slack-relay status   [--json]
  slack-relay agents   [--json]
  slack-relay models   [--json] [opencode|claude|pi...]
  slack-relay connectors [--json] [NAME...]
  slack-relay channels [--json]
  slack-relay memory   [show | path | --json | set]   (set reads stdin)
  slack-relay spawn    <repo> <task> [--name NAME] [--runner opencode|claude|pi] [--model ID]
  slack-relay remove   <worker>...   (stops it if it is still working, then deletes its state and log)
  slack-relay activity <worker|turn> [--json] [--limit N]   (what its agent did so far: tools, text, errors)
  slack-relay cancel   <worker|turn>...   (stops it like "!<name> stop"; a turn is a dispatcher answer's ID from status --json)
  slack-relay post     <id:channel> <label> <message>
  slack-relay ask      <id:channel> <label> <message> [--timeout SEC]
  slack-relay wait     <id:channel> <label> [--since TS] [--timeout SEC]
  slack-relay --version

Config: ~/.config/slack-relay/config.json (SLACK_RELAY_CONFIG). Every key and its
default is described in config.schema.json; keys use dots: dispatcher.models.claude.
State: ~/.local/state/slack-relay (SLACK_RELAY_STATE): serve.json, serve.log,
workers/<name>.json, .log and .events, and dispatch/<turn>.json and .events.

Agent posts are prefixed "<icon> [label]". Messages count only when written by
the configured user and starting with the trigger, "!" by default (or "@bot"). ask/wait print the reply text and
exit 0, or exit 3 on timeout (default 3600s, 0 = forever) and print the wait
command that resumes from the same point.
EOF
}

die() { echo "slack-relay: $*" >&2; exit 1; }

# Defaults from the schema: each property's "default", or an object of its properties' defaults.
defaults_json() {
  [[ -r "$SCHEMA" ]] || die "schema missing: $SCHEMA"
  jq -c 'def d: if has("default") then .default elif .type == "object" then (.properties // {} | map_values(d)) else null end; d' "$SCHEMA"
}
DEFAULTS=$(defaults_json)

# The effective config: schema defaults deep-merged with the user's file.
config_json() {
  if [[ -r "$CONFIG" ]]; then
    jq -c --argjson d "$DEFAULTS" '$d * .' "$CONFIG"
  else
    printf '%s' "$DEFAULTS"
  fi
}

cfg() { config_json | jq -r "$1 // empty" 2>/dev/null || true; }

# jq: the dispatcher's model for its current runner. A model name only fits the runner it belongs to.
DISPATCHER_MODEL='(.dispatcher.models // {})[.dispatcher.runner] // ""'

expand_path() { printf '%s' "${1/#\~/$HOME}"; }

ME="${SLACK_RELAY_USER:-$(cfg .user)}"
OWNER=$(cfg .name)
OWNER=${OWNER:-the user}
TRIGGER=$(cfg .trigger)
TRIGGER=${TRIGGER:-!}

# Every channel serve reads, the main one first.
channels() {
  config_json | jq -r 'reduce ([.channel] + (.channels // []))[] as $c ([]; if $c == "" or any(.[]; . == $c) then . else . + [$c] end) | .[]'
}

channel_id() {
  [[ "$1" == id:* ]] || die "channel must be id:<conversation-id>"
  printf '%s' "${1#id:}"
}

check_label() {
  [[ "$1" =~ ^[A-Za-z0-9_-]+$ ]] || die "label must be one word: letters, digits, - or _"
}

latest_ts() {
  slackc history "$1" 1 | cut -f1
}

# --- Slack Web API -----------------------------------------------------------------
# Calls go through slackc, which tests point at a fake with SLACK_RELAY_SLACK_BIN.
# Rows are "ts<TAB>id:channel<TAB>author<TAB>text<TAB>thread_ts". author is the Slack user
# ID, or "bot:<id>" for bot and webhook posts, so a display name never passes as a user.

slackc() {
  # Only ever read or write the channels in the config, whatever an agent passes in
  if [[ "$1" == history || "$1" == thread || "$1" == send || "$1" == update || "$1" == info ]] && ! channels | grep -Fxq -- "${2#id:}"; then
    die "channel ${2#id:} is not in the config (channel, channels); refusing to touch it"
  fi
  if [[ -n "${SLACK_RELAY_SLACK_BIN:-}" ]]; then
    "$SLACK_RELAY_SLACK_BIN" "$@"
    return
  fi
  local action=$1; shift
  case "$action" in
    history) slack_history "$@" ;;
    thread) slack_thread "$@" ;;
    send) slack_send "$@" ;;
    # chat.update escapes <links> unless told to read text the way chat.postMessage does
    update) slack_api POST chat.update "channel=$1" "ts=$2" "text=$3" "parse=none" >/dev/null ;;
    whoami) slack_api GET auth.test | jq -r '.user_id' ;;
    url) slack_api GET auth.test | jq -r '.url // empty' ;;
    info) slack_info "$1" ;;
    *) die "unknown slack action $action" ;;
  esac
}

# Writes a curl config with the credentials, so the token never shows in a process list.
slack_curl_config() {
  local token_file cookie_file token cookie=""
  token_file=$(expand_path "$(cfg .slack.token_file)")
  cookie_file=$(expand_path "$(cfg .slack.cookie_file)")
  [[ -r "$token_file" ]] || die "Slack token missing: $token_file (config slack.token_file)"
  token=$(tr -d '\r\n' <"$token_file")
  [[ -n "$token" ]] || die "Slack token file is empty: $token_file"
  [[ -z "$cookie_file" || ! -r "$cookie_file" ]] || cookie=$(tr -d '\r\n' <"$cookie_file")
  [[ "$token" != xoxc-* || -n "$cookie" ]] || die "an xoxc- token needs its d cookie: set slack.cookie_file"
  {
    printf 'header = "Authorization: Bearer %s"\n' "${token//\"/\\\"}"
    [[ -z "$cookie" ]] || printf 'cookie = "d=%s"\n' "${cookie//\"/\\\"}"
  } >"$1"
}

slack_api() {
  local method=$1 endpoint=$2 dir status error attempt
  shift 2
  dir=$(mktemp -d "${TMPDIR:-/tmp}/slack-relay-api.XXXXXX")
  (umask 077; slack_curl_config "$dir/curl.conf") || { rm -rf "$dir"; return 1; }
  local -a args=(--silent --show-error --max-time 20 --connect-timeout 10 --config "$dir/curl.conf" -o "$dir/body" -w '%{http_code}' -X "$method")
  [[ "$method" != GET ]] || args+=(-G)
  local param
  for param in "$@"; do args+=(--data-urlencode "$param"); done
  for attempt in 1 2; do
    if ! status=$("${SLACK_RELAY_CURL:-curl}" "${args[@]}" "${SLACK_RELAY_API:-https://slack.com/api}/$endpoint" 2>/dev/null); then
      rm -rf "$dir"; echo "slack-relay: Slack request failed (network?)" >&2; return 1
    fi
    if [[ "$status" =~ ^2 ]] && jq -e '.ok == true' "$dir/body" >/dev/null 2>&1; then
      cat "$dir/body"; rm -rf "$dir"; return 0
    fi
    error=$(jq -r '.error // empty' "$dir/body" 2>/dev/null || true)
    [[ ( "$status" == 429 || "$error" == ratelimited ) && $attempt == 1 ]] || break
    sleep 2
  done
  rm -rf "$dir"
  echo "slack-relay: Slack $endpoint failed: ${error:-HTTP $status}" >&2
  return 1
}

# A channel's name, or "@handle" of the person on the other end of a DM, which has no name.
slack_info() {
  local info user
  info=$(slack_api GET conversations.info "channel=$1") || return 1
  user=$(jq -r 'if .channel.is_im then .channel.user // empty else empty end' <<<"$info")
  if [[ -z "$user" ]]; then
    jq -r '.channel.name // empty' <<<"$info"
    return
  fi
  slack_api GET users.info "user=$user" | jq -r '.user | ((.profile.display_name // "") | if . == "" then null else . end) // .name // empty | "@" + .'
}

slack_rows() {
  jq -r --arg id "$1" '
    def safe: tostring | gsub("[[:cntrl:]]"; "");
    def author: if .bot_id != null or .user == null or .subtype == "bot_message"
      then "bot:" + ((.bot_id // .username // "unknown") | tostring) else .user end;
    .messages[]? | [(.ts | safe), ("id:" + $id), (author | safe), ((.text // "") | safe), ((.thread_ts // "") | safe)] | @tsv'
}

# slack_history <channel> <limit> [since]: channel messages, plus replies in threads active after since.
slack_history() {
  local id=$1 limit=$2 since=${3:-} response page cursor="" pages=0 thread
  if [[ -z "$since" ]]; then
    response=$(slack_api GET conversations.history "channel=$id" "limit=$limit") || return 1
    slack_rows "$id" <<<"$response"
    return 0
  fi
  # The newest messages, and older pages only until they reach the last poll, so a burst of other
  # people's posts can't push the user's out. No oldest=: a reply doesn't bring its parent back after
  # it, and the parents are how threads with new replies are found. Callers drop rows up to since.
  response='{"messages":[]}'
  while :; do
    page=$(slack_api GET conversations.history "channel=$id" "limit=$limit" ${cursor:+"cursor=$cursor"}) || return 1
    response=$(jq -c --argjson p "$page" '.messages += ($p.messages // [])' <<<"$response")
    cursor=$(jq -r '.response_metadata.next_cursor // empty' <<<"$page")
    (( ++pages < 20 )) && [[ -n "$cursor" ]] \
      && [[ $(jq -r --arg s "$since" '(.messages | map(.ts | tonumber) | min // 0) > ($s | tonumber)' <<<"$page") == true ]] || break
  done
  slack_rows "$id" <<<"$response"
  # Only threads the user started or replied in: other people's threads cost no API calls.
  while IFS= read -r thread; do
    [[ "$thread" =~ ^[0-9]+\.[0-9]+$ ]] || continue
    slack_api GET conversations.replies "channel=$id" "ts=$thread" "oldest=$since" "limit=100" \
      | jq --arg t "$thread" '.messages |= map(select(.ts != $t))' | slack_rows "$id"
  done < <(jq -r --arg s "$since" --arg me "$ME" '.messages[]? | select(.latest_reply != null and (.latest_reply | tonumber) > ($s | tonumber))
    | select(.user == $me or ((.reply_users // []) | index($me) != null)) | .ts' <<<"$response")
}

# slack_thread <channel> <thread_ts> <limit>: the whole thread, parent first.
slack_thread() {
  slack_api GET conversations.replies "channel=$1" "ts=$2" "limit=$3" | slack_rows "$1"
}

# slack_send <channel> <text> [thread_ts]: prints the new message's ts.
slack_send() {
  local -a params=("channel=$1" "text=$2")
  [[ -z "${3:-}" || "$3" == - ]] || params+=("thread_ts=$3")
  slack_api POST chat.postMessage "${params[@]}" | jq -r '.ts // empty'
}

# Rewrites common Markdown into Slack mrkdwn, so a model's habits don't leak into posts,
# and links every Jira key of a configured project that is not already inside a link.
slackify() {
  local jira projects
  jira=$(cfg .jira_url)
  projects=$(config_json | jq -r '(.jira_projects // []) | map(select(test("^[A-Z][A-Z0-9]+$"))) | join("|")' 2>/dev/null || true)
  sed -E \
    -e 's/\*\*([^*]+)\*\*/*\1*/g' \
    -e 's/\[([^]]+)\]\((https?:[^)]+)\)/<\2|\1>/g' \
    -e 's/^#{1,6}[[:space:]]+(.*)$/*\1*/' \
    -e 's#(^|[^<|])(https://[A-Za-z0-9.-]+\.atlassian\.net/browse/([A-Z][A-Z0-9]+-[0-9]+))#\1<\2|\3>#g' \
    | if [[ -n "$jira" && -n "$projects" ]]; then
        JIRA="${jira%/}" perl -pe 's{(<[^>]*>)|\b((?:'"$projects"')-\d+)\b}{defined $1 ? $1 : "<$ENV{JIRA}/browse/$2|$2>"}ge'
      else
        cat
      fi
}

# Posts to the channel, or into SLACK_RELAY_THREAD when set, and prints the post's ts.
# With a ts as $4 it rewrites that post instead, posting anew if Slack won't edit it.
post() {
  local icon tag="" text
  if [[ "$2" == "$(cfg .dispatcher.label)" ]]; then icon=$(cfg .dispatcher.icon); else icon=$(cfg .worker.icon); fi
  [[ "$(config_json | jq .show_label)" == false ]] || tag=" [$2]"
  text="${icon:-$(cfg .icon)}$tag $(slackify <<<"$3")"
  if [[ -n "${4:-}" ]] && slackc update "$1" "$4" "$text" >/dev/null 2>&1; then
    printf '%s\n' "$4"
    return
  fi
  slackc send "$1" "$text" "${SLACK_RELAY_THREAD:--}"
}

# Prints "ts<TAB>label<TAB>thread<TAB>text" for each message from ME after <since>, in the
# channel or any thread, oldest first. label is "." when the message does not start with
# "@bot" or the trigger, and "@" when no name follows it; thread and an empty text are "-".
messages_after() {
  local id=$1 since=$2
  slackc history "$id" 50 "$since" \
    | awk -F'\t' -v since="$since" -v me="$ME" '($1 "") > (since "") && $3 == me' \
    | sort -t$'\t' -k1,1 -u \
    | while IFS=$'\t' read -r ts _ _ text thread; do
        [[ -n "$thread" && "$thread" != "$ts" ]] || thread=-
        local rest label=@ body
        if [[ "$text" =~ ^@[Bb][Oo][Tt]([[:space:]:,]+(.*))?$ ]]; then
          rest=${BASH_REMATCH[2]}
        elif [[ "$text" == "$TRIGGER"* ]]; then
          rest=${text#"$TRIGGER"}
          rest=${rest#"${rest%%[![:space:]]*}"}
        else
          printf '%s\t.\t%s\t-\n' "$ts" "$thread"
          continue
        fi
        body=$rest
        if [[ "$rest" =~ ^([A-Za-z0-9_-]+)([[:space:]:,]+(.*))?$ ]]; then
          label=${BASH_REMATCH[1]}
          body=${BASH_REMATCH[3]}
        fi
        body=${body//&lt;/<}
        body=${body//&gt;/>}
        body=${body//&amp;/\&}
        printf '%s\t%s\t%s\t%s\n' "$ts" "$label" "$thread" "${body:--}"
      done
}

worker_file() { printf '%s/workers/%s.json' "$STATE" "$1"; }

set_state() {
  local file tmp
  file=$(worker_file "$1"); shift
  tmp=$(mktemp "$file.XXXXXX")
  jq "$@" "$file" >"$tmp" && mv "$tmp" "$file"
}

# running | waiting | done | failed | died | none
worker_status() {
  local file status pid
  file=$(worker_file "$1")
  [[ -f "$file" ]] || { echo none; return; }
  status=$(jq -r '.status' "$file")
  pid=$(jq -r '.pid // 0' "$file")
  if [[ "$status" == running || "$status" == waiting ]] && ! kill -0 "$pid" 2>/dev/null; then
    echo died
  else
    echo "$status"
  fi
}

wait_reply() {
  local id=$1 label=$2 since=$3 timeout=$4 start=$SECONDS line
  label=$(tr '[:upper:]' '[:lower:]' <<<"$label")
  while :; do
    line=$(messages_after "$id" "$since" | awk -F'\t' -v l="$label" 'tolower($2) == l' | head -n 1)
    if [[ -n "$line" ]]; then
      local ts _label _thread text
      IFS=$'\t' read -r ts _label _thread text <<<"$line"
      [[ "$text" != - ]] || text=""
      printf '%s\n' "$text"
      if [[ -n "${SLACK_RELAY_WORKER:-}" && -f "$(worker_file "$SLACK_RELAY_WORKER")" ]]; then
        set_state "$SLACK_RELAY_WORKER" --arg ts "$ts" '.answered_ts = $ts | .status = "running"'
      fi
      return 0
    fi
    if (( timeout > 0 && SECONDS - start >= timeout )); then
      echo "slack-relay: no reply for [$label] after ${timeout}s. Keep waiting: slack-relay wait id:$id $label --since $since --timeout $timeout" >&2
      return 3
    fi
    sleep "$INTERVAL"
  done
}

parse_timeout() {
  [[ "$1" =~ ^[0-9]+$ ]] || die "--timeout needs seconds"
  printf '%s' "$1"
}

# Runs one agent turn and prints its final text reply.
# resume=true continues an existing session; claude needs --resume there instead of --session-id.
# With SLACK_RELAY_EVENTS set, the agent's output is also appended there as it streams, for `activity`.
run_agent() {
  local runner=$1 workdir=$2 session=$3 resume=$4 model=$5 auto=$6 title=$7 prompt=$8 agent=${9:-} out err settings
  local -a cmd
  case "$runner" in
    opencode)
      cmd=(opencode run --format json --title "$title")
      [[ -z "$agent" ]] || cmd+=(--agent "$agent")
      [[ -z "$session" ]] || cmd+=(--session "$session")
      [[ "$auto" != true ]] || cmd+=(--auto)
      ;;
    claude)
      # stream-json prints each step as it happens; the last line is the same result object json gives
      cmd=(claude -p --output-format stream-json --verbose)
      settings=$(config_json | jq -c '.claude_settings // {}')
      if [[ -n "$session" && "$resume" == true ]]; then
        cmd+=(--resume "$session")
      elif [[ -n "$session" ]]; then
        cmd+=(--session-id "$session")
      else
        # the dispatcher (no session) remembers through MEMORY.md, not claude's own memory files
        settings=$(jq -c '. * {autoMemoryEnabled: false}' <<<"$settings")
      fi
      [[ "$settings" == "{}" ]] || cmd+=(--settings "$settings")
      [[ "$auto" != true ]] || cmd+=(--dangerously-skip-permissions)
      ;;
    pi)
      # pi -p runs tools without asking, so auto has no effect
      cmd=(pi -p)
      if [[ -n "$session" ]]; then cmd+=(--session-id "$session"); else cmd+=(--no-session); fi
      ;;
    *)
      printf 'error: unknown runner "%s" (use opencode, claude, or pi)' "$runner"
      return 1
      ;;
  esac
  [[ -z "$model" ]] || cmd+=(--model "$model")
  err=$(mktemp "${TMPDIR:-/tmp}/slack-relay.XXXXXX")
  local events=${SLACK_RELAY_EVENTS:-/dev/null}
  # what the relay asked of the agent, and where, as the feed's first step
  [[ "$events" == /dev/null ]] || jq -nc --arg r "$runner" --arg d "$workdir" --arg m "$model" --arg p "$prompt" \
    --argjson c "$(printf '%s\n' "${cmd[@]}" | jq -R . | jq -sc .)" \
    '{type: "relay", runner: $r, cwd: $d, model: $m, command: $c, prompt: $p}' >>"$events"
  # stdin must not be a pipe, or the agent CLI waits for EOF forever; pipefail keeps the agent's exit status
  if ! out=$(cd "$workdir" && "${cmd[@]}" "$prompt" </dev/null 2>"$err" | tee -a "$events"); then
    [[ "$runner" != claude ]] || out=$(jq -c 'select(.type == "result")' 2>/dev/null <<<"$out" | tail -n 1 || true)
    # claude and opencode exit 1 on errors but explain them in their JSON output; stderr is noise or empty then
    local reason=""
    case "$runner" in
      claude) reason=$(jq -r 'select(.is_error == true) | .result // empty' <<<"$out" 2>/dev/null || true) ;;
      opencode) reason=$(jq -rs '[.[] | select(.type == "error") | .error.message // .error.data.message // empty] | last // empty' <<<"$out" 2>/dev/null || true) ;;
    esac
    printf 'error: %s' "${reason:-$(tail -n 5 "$err")}"
    rm -f "$err"
    return 1
  fi
  rm -f "$err"
  case "$runner" in
    opencode) out=$(jq -rs '[.[] | select(.type == "text") | .part.text] | last // empty' <<<"$out" 2>/dev/null || true) ;;
    claude)
      out=$(jq -c 'select(.type == "result")' 2>/dev/null <<<"$out" | tail -n 1 || true)
      if [[ "$(jq -r '.is_error // false' <<<"$out" 2>/dev/null)" == true ]]; then
        printf 'error: %s' "$(jq -r '.result // "claude failed"' <<<"$out")"
        return 1
      fi
      out=$(jq -r '.result // empty' <<<"$out" 2>/dev/null || true)
      ;;
  esac
  printf '%s' "${out:-(finished with no text reply)}"
}

# Turns an agent's streamed output (claude stream-json, opencode json, or plain text from pi) into
# {kind, text, detail?} lines, oldest first. kind is relay (what the relay started, and where), start
# (the agent's session), thinking, tool, output (a tool's result), text, error, or done. text is one
# short line; detail holds the whole thing: the prompt, a tool's input, its output.
activity_rows() {
  jq -R -c --arg home "$HOME" '
    def clip($n): tostring | if length > $n then .[0:$n] + "\n… (\(length - $n) more characters)" else . end;
    def line($n): tostring | gsub("\\s+"; " ") | ltrimstr(" ") | if length > $n then .[0:$n] + "…" else . end;
    def home: tostring | if startswith($home) then "~" + .[($home | length):] else . end;
    def arg: if type == "object" then (.command // .file_path // .filePath // .path // .pattern // .url // .query // .description // .prompt // tojson) else . end | line(200);
    def detail: if type == "object" then (to_entries | map(select(.value != null and .value != "") | "\(.key): \(.value | if type == "string" then . else tojson end)")
      | if . == [] then null else join("\n") | clip(4000) end) else null end;
    def result: if type == "array" then map(.text? // tojson) | join("\n") else tostring end;
    def secs: . / 1000 | . * 10 | floor / 10;
    . as $line | (try fromjson catch null) as $e
    | if ($e | type) != "object" then (select($line | test("\\S")) | {kind: "text", text: ($line | line(600))})
      elif $e.type == "relay" then {kind: "relay", text: "\($e.runner)\(if $e.model != "" then " " + $e.model else "" end) in \($e.cwd | home)",
          detail: ("$ cd \($e.cwd | home)\n$ \($e.command | map(if test("[\\s\"{]") then @sh else . end) | join(" ")) <prompt>\n\nPrompt:\n\($e.prompt | clip(20000))")}
      elif $e.type == "system" and $e.subtype == "init" then {kind: "start", text: "\($e.model // "agent") in \($e.cwd // "" | home) · \($e.tools // [] | length) tools · \($e.permissionMode // "default") permissions",
          detail: ("MCP servers: \([$e.mcp_servers[]? | "\(.name) (\(.status))"] | join(", "))\nTools: \($e.tools // [] | join(", "))")}
      elif $e.type == "system" and $e.subtype == "thinking_tokens" then {kind: "thinking", merge: true, text: "Thinking… about \($e.estimated_tokens) tokens so far (the model keeps the text to itself)"}
      elif $e.type == "assistant" then $e.message.content[]?
        | if .type == "text" then {kind: "text", text: (.text | line(300)), detail: (if (.text | length) > 300 or (.text | test("\n")) then (.text | clip(8000)) else null end)}
          elif .type == "tool_use" then {kind: "tool", text: "\(.name) \(.input | arg)", detail: (.input | detail)}
          elif .type == "thinking" and (.thinking // "") != "" then {kind: "thinking", text: (.thinking | line(300)), detail: (.thinking | clip(8000))}
          else empty end
      elif $e.type == "user" then $e.message.content[]? | select(.type == "tool_result")
        | (.content | result) as $out
        | {kind: (if .is_error == true then "error" else "output" end), text: (if ($out | test("\\S")) then $out | line(200) else "(no output)" end), detail: (if ($out | length) > 200 or ($out | test("\n")) then ($out | clip(8000)) else null end)}
      elif $e.type == "result" then
        (select($e.is_error == true) | {kind: "error", text: ($e.result // "failed" | line(600))}),
        {kind: "done", text: ([if $e.duration_ms then "\($e.duration_ms | secs)s" else empty end, if $e.num_turns then "\($e.num_turns) turns" else empty end,
          if $e.total_cost_usd then "$\($e.total_cost_usd * 10000 | round / 10000)" else empty end] | join(" · ") | "Finished" + (if . != "" then " in " + . else "" end))}
      elif $e.type == "tool_use" then
        {kind: "tool", text: "\($e.part.tool) \($e.part.state.input // {} | arg)", detail: ($e.part.state.input | detail)},
        ($e.part.state.output // empty | tostring | {kind: (if $e.part.state.status == "error" then "error" else "output" end), text: (if test("\\S") then line(200) else "(no output)" end), detail: (if length > 200 or test("\n") then clip(8000) else null end)})
      elif $e.type == "text" then ($e.part.text // "") as $t | {kind: "text", text: ($t | line(300)), detail: (if ($t | length) > 300 or ($t | test("\n")) then ($t | clip(8000)) else null end)}
      elif $e.type == "reasoning" then ($e.part.text // "") as $t | select($t != "") | {kind: "thinking", text: ($t | line(300)), detail: ($t | clip(8000))}
      elif $e.type == "error" then {kind: "error", text: ($e.error.message // $e.error.data.message // "error" | line(600))}
      else empty end
    | with_entries(select(.value != null))' 2>/dev/null \
    | jq -c -s 'reduce .[] as $r ([]; if $r.merge and (.[-1].merge // false) then .[:-1] + [$r] else . + [$r] end) | .[] | del(.merge)' 2>/dev/null || true
}

# The newest step of a run, or empty. Agent output after the last step is no step.
last_activity() {
  [[ -s "$1" ]] || return 0
  tail -n 40 "$1" | activity_rows | jq -c 'del(.detail)' | tail -n 1
}

new_session_id() {
  local runner=$1 name=${2//-/_}
  case "$runner" in
    claude) uuidgen | tr '[:upper:]' '[:lower:]' ;;
    pi) printf 'slack_%s_%s' "$name" "$(date +%s)" ;;
    *) printf 'ses_slack_%s_%s' "$name" "$(date +%s)" ;;
  esac
}

clip() {
  local text=$1
  (( ${#text} <= MAX_CHARS )) || text="${text:0:MAX_CHARS}… (truncated)"
  printf '%s' "$text"
}

command_post() {
  [[ $# -eq 3 ]] || { usage >&2; exit 2; }
  local id; id=$(channel_id "$1"); check_label "$2"
  [[ -n "$3" ]] || die "message must not be empty"
  post "$id" "$2" "$3" >/dev/null
  echo "posted [$2]"
}

command_ask() {
  [[ $# -ge 3 ]] || { usage >&2; exit 2; }
  local id label=$2 message=$3 timeout=3600 since
  id=$(channel_id "$1"); check_label "$label"
  shift 3
  while (( $# )); do
    case "$1" in
      --timeout) timeout=$(parse_timeout "${2:-}"); shift 2 ;;
      *) usage >&2; exit 2 ;;
    esac
  done
  since=$(latest_ts "$id")
  [[ "$since" =~ ^[0-9]+(\.[0-9]+)?$ ]] || die "cannot read channel $id"
  post "$id" "$label" "$message" >/dev/null
  if [[ -n "${SLACK_RELAY_WORKER:-}" && -f "$(worker_file "$SLACK_RELAY_WORKER")" ]]; then
    set_state "$SLACK_RELAY_WORKER" '.status = "waiting"'
  fi
  wait_reply "$id" "$label" "$since" "$timeout"
}

command_wait() {
  [[ $# -ge 2 ]] || { usage >&2; exit 2; }
  local id label=$2 timeout=3600 since=""
  id=$(channel_id "$1"); check_label "$label"
  shift 2
  while (( $# )); do
    case "$1" in
      --since) since=${2:-}; shift 2 ;;
      --timeout) timeout=$(parse_timeout "${2:-}"); shift 2 ;;
      *) usage >&2; exit 2 ;;
    esac
  done
  [[ -n "$since" ]] || since=$(latest_ts "$id")
  [[ "$since" =~ ^[0-9]+(\.[0-9]+)?$ ]] || die "cannot read channel $id"
  wait_reply "$id" "$label" "$since" "$timeout"
}

command_status() {
  local file name status
  shopt -s nullglob
  local files=("$STATE"/workers/*.json)
  (( ${#files[@]} )) || { echo "no workers"; return; }
  for file in "${files[@]}"; do
    name=$(basename "$file" .json)
    status=$(worker_status "$name")
    jq -r --arg s "$status" '[.name, $s, .repo, (.task | gsub("\\s+"; " ") | .[0:80])] | @tsv' "$file"
  done
}

start_worker() {
  local name=$1 prompt=$2 pid
  nohup "$SELF" _work "$name" "$prompt" >>"$STATE/workers/$name.log" 2>&1 </dev/null &
  pid=$!
  disown "$pid" 2>/dev/null || true
  set_state "$name" --argjson pid "$pid" --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '.pid = $pid | .status = "running" | .turn_started = $t'
}

link_rule() {
  local jira
  jira=$(cfg .jira_url)
  printf '%s\n%s' "- Link everything you mention, so they can tap it on their phone: CircleCI jobs and pipelines (their https://app.circleci.com/pipelines/... URL), GitHub PRs, commits and files, dashboards. Write each link as a Slack link with a short label, never a bare URL: <https://github.com/org/repo/pull/12|PR #12>, <https://app.circleci.com/pipelines/...|library-check job>.${jira:+ Write Jira keys plainly (ADE-123), once, without a link: the relay links them.}" \
    "- Format for Slack: *bold*, _italic_, \`code\`, plain - bullets. Slack does not render **double asterisks**, # headings, or tables. Never mention these formatting rules in your answer."
  sandbox_rule
}

# claude's sandbox lets excludedCommands through only when nothing else is on the command line
sandbox_rule() {
  local cmds
  cmds=$(config_json | jq -r '.claude_settings.sandbox.excludedCommands // [] | map(sub(" \\*$"; "")) | join(", ")')
  [[ -z "$cmds" ]] || printf '\n%s' "- Run $cmds as one plain command each, with no pipes, &&, ;, or redirects (not even 2>&1 | head): the sandbox lets them through only on their own."
}

worker_prompt() {
  local name=$1 task=$2 channel=$3
  cat <<EOF
$OWNER started you from Slack as worker "$name". They are away from the Mac and read Slack on their phone.
- When you need a decision, run this and treat the printed text as their answer. On exit 3 they have not answered yet: run the \`slack-relay wait …\` command it printed on stderr, and repeat.
  slack-relay ask id:$channel $name "<question>. reply: $TRIGGER$name …" --timeout 540
- Your final message is posted to Slack for you. Keep it short: what changed, where, and what is left.
$(link_rule)
- Leave commits, pushes, and PRs for them to ask for.

Task: $task
EOF
}

command_spawn() {
  [[ $# -ge 2 ]] || { usage >&2; exit 2; }
  local repo=$1 task=$2 name="" runner="" model="" dir n=2 session channel
  shift 2
  while (( $# )); do
    case "$1" in
      --name) name=${2:-}; shift 2 ;;
      --runner) runner=${2:-}; shift 2 ;;
      --model) model=${2:-}; shift 2 ;;
      *) usage >&2; exit 2 ;;
    esac
  done
  [[ -r "$CONFIG" ]] || die "missing $CONFIG; run: slack-relay init"
  runner=${runner:-$(cfg .worker.runner)}
  case "$runner" in opencode|claude|pi) ;; *) die "unknown runner '$runner' (use opencode, claude, or pi)" ;; esac
  model=${model:-$(cfg ".worker.models.$runner")}
  dir=$(cfg ".repos[\"$repo\"]")
  [[ -n "$dir" ]] || die "unknown repo '$repo'; known: $(config_json | jq -r '.repos | keys | join(", ")')"
  dir=$(expand_path "$dir")
  [[ -d "$dir" ]] || die "repo dir missing: $dir"
  name=$(tr '[:upper:]' '[:lower:]' <<<"${name:-$repo}")
  check_label "$name"
  local base=$name
  while [[ "$(worker_status "$name")" == running || "$(worker_status "$name")" == waiting || "$name" == "$(cfg .dispatcher.label)" ]]; do
    name="$base-$n"; n=$((n + 1))
  done
  session=$(new_session_id "$runner" "$name")
  channel=${SLACK_RELAY_CHANNEL:-$(cfg .channel)}
  mkdir -p "$STATE/workers"
  jq -n --arg name "$name" --arg repo "$repo" --arg dir "$dir" --arg runner "$runner" --arg model "$model" \
    --arg session "$session" --arg task "$task" --arg started "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg thread "${SLACK_RELAY_THREAD:--}" --arg channel "$channel" \
    '{name: $name, repo: $repo, dir: $dir, runner: $runner, model: $model, session: $session, channel: $channel, thread: $thread, turns: 0, task: $task, started: $started, status: "running", pid: 0}' \
    >"$(worker_file "$name")"
  start_worker "$name" "$(worker_prompt "$name" "$task" "$channel")"
  echo "started [$name] in $dir ($runner session $session)"
}

descendants() {
  local child
  for child in $(pgrep -P "$1" 2>/dev/null); do
    echo "$child"
    descendants "$child"
  done
}

command_remove() {
  [[ $# -ge 1 ]] || { usage >&2; exit 2; }
  local name file pid status
  for name in "$@"; do
    check_label "$name"
    file=$(worker_file "$name")
    [[ -f "$file" ]] || die "no worker named $name"
    status=$(worker_status "$name")
    if [[ "$status" == running || "$status" == waiting ]]; then
      pid=$(jq -r '.pid' "$file")
      kill_tree "$pid"
      echo "stopped $name (pid $pid)"
    fi
    rm -f "$file" "$STATE/workers/$name.log" "$STATE/workers/$name.events"
    echo "removed $name"
  done
}

command_work() {
  local name=$1 prompt=$2 file dir runner model session resume=false auto answer status=done
  file=$(worker_file "$name")
  dir=$(jq -r .dir "$file")
  runner=$(jq -r '.runner // "opencode"' "$file")
  model=$(jq -r '.model // ""' "$file")
  session=$(jq -r .session "$file")
  [[ "$(jq -r '.turns // 0' "$file")" == 0 ]] || resume=true
  auto=$(cfg .worker.auto)
  export SLACK_RELAY_WORKER=$name
  SLACK_RELAY_THREAD=$(jq -r '.thread // "-"' "$file")
  export SLACK_RELAY_THREAD
  # each turn starts a fresh activity feed
  export SLACK_RELAY_EVENTS="$STATE/workers/$name.events"
  : >"$SLACK_RELAY_EVENTS"
  answer=$(run_agent "$runner" "$dir" "$session" "$resume" "$model" "$auto" "slack: $name" "$prompt") || status=failed
  post "$(jq -r '.channel // empty' "$file" | grep . || cfg .channel)" "$name" "$(clip "$answer")" >/dev/null
  set_state "$name" --arg s "$status" --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '.status = $s | .finished = $t | .turns += 1'
}

dispatch() {
  local id=$1 label=$2 ts=$3 text=$4 workdir runner model agent="" auto memory answer placeholder thread_context="" thread=${SLACK_RELAY_THREAD:--}
  if [[ "$thread" != - && "$thread" != "$ts" ]]; then
    thread_context=$(slackc thread "$id" "$thread" 50 \
      | awk -F'\t' -v ts="$ts" -v me="$ME" '($1 "") < (ts "") && $3 == me { print "- " $4 }' | tail -n 30 \
      | sed -e 's/&lt;/</g' -e 's/&gt;/>/g' -e 's/&amp;/\&/g') || thread_context=""
    (( ${#thread_context} <= 4000 )) || thread_context="…${thread_context: -4000}"
  fi
  workdir=$(expand_path "$(cfg .dispatcher.workdir)")
  mkdir -p "$workdir"
  [[ -f "$workdir/MEMORY.md" ]] || : >"$workdir/MEMORY.md"
  runner=$(cfg .dispatcher.runner)
  model=$(cfg "$DISPATCHER_MODEL")
  auto=$(cfg .dispatcher.auto)
  # local models are slow to read OpenCode's full prompt, so they get a slimmer agent
  [[ "$runner" != opencode || "$model" != ollama/* ]] || agent=$(cfg .dispatcher.local_agent)
  memory=$(cat "$workdir/MEMORY.md")
  # serve runs each turn in the background; this file lets "stop" end it and edit its placeholder,
  # and stays after the turn as its record, next to the agent's output in <id>.events
  local turn_id
  turn_id="$(date +%s)-$BASHPID"
  local turn="$STATE/dispatch/$turn_id.json"
  mkdir -p "$STATE/dispatch"
  export SLACK_RELAY_EVENTS="$STATE/dispatch/$turn_id.events"
  : >"$SLACK_RELAY_EVENTS"
  jq -n --arg id "$turn_id" --arg l "$label" --argjson pid "$BASHPID" --arg c "$id" --arg t "$thread" --arg x "$text" \
    --arg s "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg r "$runner" --arg m "$model" --arg ts "$ts" --arg d "$workdir" \
    '{id: $id, label: $l, pid: $pid, channel: $c, thread: $t, ts: $ts, placeholder: "", text: $x, since: $s, runner: $r, model: $m, dir: $d, status: "running"}' >"$turn"
  # shows at once that the message arrived; the answer replaces it
  placeholder=""
  [[ -z "$(cfg .thinking)" ]] || placeholder=$(post "$id" "$label" "$(cfg .thinking)" 2>/dev/null) || placeholder=""
  if [[ -n "$placeholder" ]]; then
    set_turn "$turn_id" --arg p "$placeholder" '.placeholder = $p'
  fi
  local status=done
  answer=$(run_agent "$runner" "$workdir" "" false "$model" "$auto" "slack: $label" "$(cat <<EOF
You are "$label", $OWNER's assistant on their Mac. They write from Slack on their phone. Every message starts a fresh session, so MEMORY.md is all you remember.
- Answer whatever they ask directly and in a few lines, like any good assistant: general knowledge, a word, a joke, a quick lookup. Read words in their plain everyday meaning; only treat one as a repo, worker, or ticket when it clearly is one. Don't ask what they meant when a sensible reading exists.
$(link_rule)
- For real work in a repo, start a worker instead of doing it yourself: put this JSON on its own line in your reply, with a self-contained task. The relay starts the worker and adds its name to your reply.
  SPAWN {"repo": "<repo>", "task": "<task>"}
  Add "runner": "claude", "opencode", or "pi" when they name a tool (default: $(cfg .worker.runner)). Add "model": "<id>" only when they name a model.
  Never run slack-relay spawn yourself: your shell may be sandboxed away from Slack and the repos. They talk to a worker with $TRIGGER<name>.
- Repos: $(config_json | jq -r '.repos | to_entries | map("\(.key)=\(.value)") | join(", ")')
- Workers (name, status, repo, task):
$(command_status | sed 's/^/  /')
- MEMORY.md ($workdir/MEMORY.md) holds their standing notes. Edit it only when they ask you to remember or forget something, and keep it under $(cfg .dispatcher.memory_lines) lines.

MEMORY.md:
${memory:-(empty)}
${thread_context:+
They wrote this in a Slack thread. Earlier messages in it, oldest first (all from their account; lines starting with the icon are agent posts):
$thread_context
}
Message from $OWNER: $text
EOF
)" "$agent") || status=failed
  local line started=""
  while IFS= read -r line; do
    started+=$'\n'$(spawn_request "${line#SPAWN }")
  done < <(grep '^SPAWN {' <<<"$answer" || true)
  answer=$(grep -v '^SPAWN {' <<<"$answer" || true)
  answer="${answer:+$answer$'\n'}${started#$'\n'}"
  answer=$(clip "${answer:-(finished with no text reply)}")
  post "$id" "$label" "$answer" "$placeholder" >/dev/null
  set_turn "$turn_id" --arg s "$status" --arg a "$answer" --arg f "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '.status = $s | .answer = $a | .finished = $f'
}

turn_file() { printf '%s/dispatch/%s.json' "$STATE" "$1"; }

set_turn() {
  local file tmp
  file=$(turn_file "$1"); shift
  [[ -f "$file" ]] || return 0
  tmp=$(mktemp "$file.XXXXXX")
  jq "$@" "$file" >"$tmp" && mv "$tmp" "$file"
}

# Every dispatcher turn on record, newest first, with "died" for a running one whose process is gone.
# Old finished turns are deleted, so the newest 20 stay.
dispatch_records() {
  local file n=0 status
  shopt -s nullglob
  local -a files=("$STATE"/dispatch/*.json)
  (( ${#files[@]} )) || return 0
  while IFS= read -r file; do
    status=$(jq -r '.status // "running"' "$file" 2>/dev/null) || continue
    if [[ "$status" == running ]] && ! kill -0 "$(jq -r '.pid // 0' "$file")" 2>/dev/null; then
      status=died
    fi
    if [[ "$status" != running ]] && (( ++n > 20 )); then
      rm -f "$file" "${file%.json}.events"
      continue
    fi
    jq -c --arg s "$status" --arg e "${file%.json}.events" --arg i "$(basename "$file" .json)" '. + {id: (.id // $i), status: $s, events: $e}' "$file"
  done < <(for file in "${files[@]}"; do printf '%s\t%s\n' "$(jq -r '.since // ""' "$file" 2>/dev/null)" "$file"; done | sort -r | cut -f2-)
}

# Dispatcher turns still running, as JSON lines.
dispatch_turns() {
  dispatch_records | jq -c 'select(.status == "running")'
}

is_stop() { [[ "${1,,}" =~ ^stop[.!]*$ ]]; }

# Ends a process and everything it started, the process first so it can't post its killed child's error.
kill_tree() {
  local -a tree
  mapfile -t tree < <(descendants "$1")
  kill -TERM "$1" "${tree[@]}" 2>/dev/null || true
}

# Ends one running dispatcher turn (a dispatch_records line) and turns its placeholder into "Stopped."
stop_turn() {
  local turn=$1 label=$2 id
  id=$(jq -r .id <<<"$turn")
  kill_tree "$(jq -r .pid <<<"$turn")"
  set_turn "$id" --arg f "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '.status = "stopped" | .finished = $f'
  # a subshell, so a channel no longer in the config can't end the caller
  (SLACK_RELAY_THREAD=$(jq -r .thread <<<"$turn") \
    post "$(jq -r .channel <<<"$turn")" "$label" "Stopped." "$(jq -r .placeholder <<<"$turn")" >/dev/null) || true
  echo "[$(date +%T)] [$label] stopped: $(jq -r .text <<<"$turn")" >&2
}

# "!<dispatcher> stop": ends every running dispatcher turn.
stop_dispatches() {
  local id=$1 label=$2 turn n=0
  while IFS= read -r turn; do
    stop_turn "$turn" "$label"
    n=$((n + 1))
  done < <(dispatch_turns)
  if (( n )); then
    post "$id" "$label" "Stopped $n request$( (( n == 1 )) || echo s)." >/dev/null
  else
    post "$id" "$label" "Nothing to stop." >/dev/null
  fi
}

# Ends a running worker; it keeps its session, so "!<name> …" picks it up again. The confirmation goes
# to <channel> and SLACK_RELAY_THREAD when given (a Slack "stop"), else to where the worker posts.
stop_worker() {
  local name=$1 channel=${2:-} file
  file=$(worker_file "$name")
  kill_tree "$(jq -r '.pid' "$file")"
  set_state "$name" --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '.status = "stopped" | .finished = $t'
  echo "[$(date +%T)] [$name] stopped" >&2
  if [[ -z "$channel" ]]; then
    channel=$(jq -r '.channel // empty' "$file" | grep . || cfg .channel)
    local SLACK_RELAY_THREAD
    SLACK_RELAY_THREAD=$(jq -r '.thread // "-"' "$file")
    export SLACK_RELAY_THREAD
  fi
  (post "$channel" "$name" "Stopped. Write $TRIGGER$name … to pick it up again." >/dev/null) || true
}

# Starts a worker for one SPAWN line from the dispatcher; serve runs it so the agent's own sandbox doesn't matter.
spawn_request() {
  local -a args
  mapfile -d '' args < <(jq -j 'select((.repo | type) == "string" and (.task | type) == "string" and .task != "")
    | [.repo, .task] + ([("name", "runner", "model") as $k | select(.[$k] | type == "string") | "--\($k)", .[$k]])
    | map(. + "\u0000") | add' <<<"$1" 2>/dev/null)
  (( ${#args[@]} >= 2 )) || { printf 'could not start a worker from: %s' "$1"; return; }
  (command_spawn "${args[@]}") 2>&1 || true
}

route() {
  local id=$1 dispatcher=$2 ts=$3 label=$4 text=$5 name status answered
  name=$(tr '[:upper:]' '[:lower:]' <<<"$label")
  # only the dispatcher's name or a worker's name gets an answer; anything else is ignored
  if [[ "$label" == @ || ( "$name" != "$dispatcher" && "$(worker_status "$name")" == none ) ]]; then
    echo "[$(date +%T)] ignored: no dispatcher or worker named '${label#@}'" >&2
    return 0
  fi
  if [[ "$name" == "$dispatcher" ]]; then
    [[ -n "$text" ]] || return 0
    echo "[$(date +%T)] [$name] in: $text" >&2
    if is_stop "$text"; then
      stop_dispatches "$id" "$name"
    else
      # in the background, so serve keeps reading and "stop" can reach a slow turn
      dispatch "$id" "$name" "$ts" "$text" &
    fi
    return
  fi
  label=$name
  status=$(worker_status "$label")
  if [[ ( "$status" == running || "$status" == waiting ) ]] && is_stop "$text"; then
    stop_worker "$label" "$id"
    return
  fi
  case "$status" in
    waiting)
      ;;
    running)
      answered=$(jq -r '.answered_ts // ""' "$(worker_file "$label")")
      [[ -n "$answered" && ! "$ts" > "$answered" ]] \
        || post "$id" "$label" "Still working. I only read replies after I ask a question." >/dev/null
      ;;
    *)
      [[ -n "$text" ]] || return 0
      echo "[$(date +%T)] [$label] resume: $text" >&2
      set_state "$label" --arg thread "${SLACK_RELAY_THREAD:--}" --arg channel "$id" '.thread = $thread | .channel = $channel'
      start_worker "$label" "$text"
      post "$id" "$label" "picked it up…" >/dev/null
      ;;
  esac
}

# serve_load: (re)reads the settings serve keeps in memory into command_serve's locals. A channel
# that is new since the last load starts from its newest message; one that was dropped is forgotten.
serve_load() {
  local id ts
  local -a want
  TRIGGER=$(cfg .trigger); TRIGGER=${TRIGGER:-!}
  OWNER=$(cfg .name); OWNER=${OWNER:-the user}
  dispatcher=$(cfg .dispatcher.label)
  dispatcher=$(tr '[:upper:]' '[:lower:]' <<<"$dispatcher")
  mapfile -t want < <(channels)
  ids=()
  for id in "${want[@]}"; do
    [[ "$id" =~ ^[A-Z0-9]+$ ]] || { echo "serve: skipping channel $id, not a conversation ID" >&2; continue; }
    if [[ -z "${since[$id]:-}" ]]; then
      ts=${SLACK_RELAY_SINCE:-$(latest_ts "$id")}
      [[ "$ts" =~ ^[0-9]+(\.[0-9]+)?$ ]] || { echo "serve: cannot read channel $id; run: slack-relay doctor" >&2; continue; }
      # from now, not from the newest channel message: replies in threads come after that one, and a
      # restart would answer them again
      [[ -n "${SLACK_RELAY_SINCE:-}" ]] || ts="$(date +%s).000000"
      since[$id]=$ts
    fi
    ids+=("$id")
  done
  for id in "${!since[@]}"; do
    printf '%s\n' "${ids[@]}" | grep -Fxq -- "$id" || unset 'since[$id]'
  done
  config_sum=$(cksum <"$CONFIG")
  # what serve is really using, so an app can show a setting has landed
  serve_update --arg t "$TRIGGER" --arg d "$dispatcher" --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --argjson c "$(printf '%s\n' "${ids[@]}" | jq -Rsc 'split("\n") | map(select(. != ""))')" \
    '.channel = $c[0] | .channels = $c | .trigger = $t | .dispatcher = $d | .config_loaded = $at'
  echo "serve: channels=${ids[*]} trigger=$TRIGGER dispatcher=[$dispatcher]" >&2
}

command_serve() {
  [[ -r "$CONFIG" ]] || die "missing $CONFIG; run: slack-relay init"
  config_errors | sed 's/^/config: /' >&2
  [[ -z "$(config_errors)" ]] || die "fix the config first: slack-relay config validate"
  local id dispatcher config_sum
  local -a ids
  local -A since
  mkdir -p "$STATE/workers"
  local serve_file="$STATE/serve.json" other owner
  other=$(serve_json | jq -r 'select(.running) | .pid')
  [[ -z "$other" || "$other" == "$$" ]] || die "already running (pid $other)"
  owner=$(slackc whoami) || die "cannot reach Slack; run: slack-relay doctor"
  [[ "$owner" == "$ME" ]] || die "the Slack token belongs to $owner, not the configured user $ME"
  local slack_url
  # the workspace address, so an app can link to the message a run came from
  slack_url=$(slackc url 2>/dev/null) || slack_url=""
  jq -n --argjson pid $$ --arg started "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg u "$slack_url" \
    '{pid: $pid, started: $started, last_poll: null, slack_url: (if $u == "" then null else $u end)}' >"$serve_file"
  serve_load
  (( ${#ids[@]} )) || { rm -f "$serve_file"; die "no readable channel in the config; run: slack-relay doctor"; }
  echo "serve: state=$STATE" >&2
  while :; do
    # settings changed in the app or with config set apply from the next poll
    if [[ "$(cksum <"$CONFIG")" != "$config_sum" ]]; then
      if [[ -z "$(config_errors)" ]]; then
        serve_load
      else
        config_sum=$(cksum <"$CONFIG")
        echo "serve: config is invalid, keeping the previous settings" >&2
      fi
    fi
    for id in "${ids[@]}"; do
      export SLACK_RELAY_CHANNEL=$id
      while IFS=$'\t' read -r ts label thread text; do
        since[$id]=$ts
        [[ "$label" != . ]] || continue
        [[ "$text" != - ]] || text=""
        # a message in the channel gets its answer in a thread under it
        [[ "$thread" != - || "$(config_json | jq .reply_in_thread)" == false ]] || thread=$ts
        export SLACK_RELAY_THREAD=$thread
        route "$id" "$dispatcher" "$ts" "$label" "$text"
      done < <(messages_after "$id" "${since[$id]}")
    done
    [[ "${SLACK_RELAY_ONCE:-0}" != 1 ]] || wait
    # busy tells an app what the dispatcher is working on, the newest turn when there are several
    serve_update --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg l "$dispatcher" --argjson b "$(dispatch_turns | jq -sc 'max_by(.since)')" \
      '.last_poll = $t | .busy = ($b | if . then {label: $l, text, since} else null end)'
    [[ "${SLACK_RELAY_ONCE:-0}" != 1 ]] || break
    sleep "$INTERVAL"
  done
}

require_user() {
  [[ -n "$ME" ]] || die "no Slack user configured; run: slack-relay config set user U0123456789"
}

normalize_channel() {
  local value=$1
  [[ "$value" =~ /archives/([A-Z0-9]+) ]] && value=${BASH_REMATCH[1]}
  printf '%s' "${value#id:}"
}

# Prints one "<key>: <problem>" line per invalid setting in the effective config.
config_errors() {
  if [[ -e "$CONFIG" ]] && ! jq empty "$CONFIG" 2>/dev/null; then
    echo "config: $CONFIG is not valid JSON"
    return
  fi
  config_json | jq -r '
    def re($p): type == "string" and test($p);
    def runner: IN("opencode", "claude", "pi");
    (if .channel | re("^[CDG][A-Z0-9]{8,}$") then empty else "channel: Slack conversation ID like C0123456789, or the channel link (now \(.channel | tojson))" end),
    (if .user | re("^[UW][A-Z0-9]{8,}$") then empty else "user: your Slack member ID like U0123456789 (now \(.user | tojson))" end),
    (if .name | type == "string" then empty else "name: text" end),
    (if (.channels | type) == "array" and all(.channels[]; re("^[CDG][A-Z0-9]{8,}$")) then empty else "channels: list of conversation IDs like [\"C0123456789\"]" end),
    (if .trigger | re("^\\S+$") then empty else "trigger: one word with no spaces, like ! or :zap:" end),
    (if .icon | re(".") then empty else "icon: an emoji like :robot_face:" end),
    (if (.show_label | type) == "boolean" then empty else "show_label: true or false" end),
    (if (.reply_in_thread | type) == "boolean" then empty else "reply_in_thread: true or false" end),
    (if (.thinking | type) == "string" then empty else "thinking: text or an emoji, or empty for none" end),
    (if (.dispatcher.icon | type) == "string" and (.worker.icon | type) == "string" then empty else "dispatcher.icon, worker.icon: an emoji, or empty for icon" end),
    (. as $c | .trigger as $t | ["icon"], ["dispatcher", "icon"], ["worker", "icon"]
      | . as $p | ($p | join(".")) as $k
      | select(($t | type) == "string" and ($c | getpath($p) | type == "string" and . != "" and startswith($t)))
      | "\($k): agent posts start with their icon, so it must not start with the trigger \($t)", "trigger: \($k) starts with it, and agent posts start with their icon"),
    (if .slack.token_file | re(".") then empty else "slack.token_file: path to your Slack token file" end),
    (if .slack.cookie_file | type == "string" then empty else "slack.cookie_file: path, or empty for xoxp- tokens" end),
    (if .jira_url == "" or (.jira_url | re("^https://")) then empty else "jira_url: https:// address or empty" end),
    (if (.jira_projects | type) == "array" and all(.jira_projects[]; re("^[A-Z][A-Z0-9]+$")) then empty else "jira_projects: list of project keys like [\"ADE\"]" end),
    (if .dispatcher.label | re("^[a-z0-9_-]+$") then empty else "dispatcher.label: one lowercase word" end),
    (if .dispatcher.runner | runner then empty else "dispatcher.runner: opencode, claude, or pi" end),
    (if (.dispatcher.models | type) == "object" and all(.dispatcher.models[]; type == "string") then empty else "dispatcher.models: model per runner, e.g. {\"claude\": \"haiku\"}" end),
    (if .dispatcher.workdir | re(".") then empty else "dispatcher.workdir: a folder path" end),
    (if .dispatcher.local_agent | type == "string" then empty else "dispatcher.local_agent: an OpenCode agent name, or empty" end),
    (if (.dispatcher.auto | type) == "boolean" then empty else "dispatcher.auto: true or false" end),
    (if (.dispatcher.memory_lines | type) == "number" and .dispatcher.memory_lines >= 1 then empty else "dispatcher.memory_lines: a number of lines, 1 or more" end),
    (if .worker.runner | runner then empty else "worker.runner: opencode, claude, or pi" end),
    (if (.worker.models | type) == "object" and all(.worker.models[]; type == "string") then empty else "worker.models: model per runner, e.g. {\"claude\": \"sonnet\"}" end),
    (if (.worker.auto | type) == "boolean" then empty else "worker.auto: true or false" end),
    (if (.claude_settings | type) == "object" then empty else "claude_settings: Claude Code settings object, e.g. {\"sandbox\": {\"excludedCommands\": [\"acli *\"]}}" end),
    (if (.repos | type) == "object" and all(.repos | to_entries[]; (.key | test("^[a-z0-9_-]+$")) and (.value | re("."))) then empty else "repos: map of one-word lowercase name to folder path" end),
    (if (.connectors | type) == "object" and all(.connectors | to_entries[]; (.key | test("^[a-z0-9_-]+$")) and (.value | type) == "object" and (.value.check // "" | type) == "string") then empty else "connectors: map of one-word lowercase name to {\"title\": …, \"check\": \"<command>\"}" end)
  '
}

command_init() {
  local channel="" user="" name="" token_file="" cookie_file="" force=false
  while (( $# )); do
    case "$1" in
      --channel) channel=$(normalize_channel "${2:-}"); shift 2 ;;
      --user) user=${2:-}; shift 2 ;;
      --name) name=${2:-}; shift 2 ;;
      --token-file) token_file=${2:-}; shift 2 ;;
      --cookie-file) cookie_file=${2:-}; shift 2 ;;
      --force) force=true; shift ;;
      *) usage >&2; exit 2 ;;
    esac
  done
  [[ ! -e "$CONFIG" || "$force" == true ]] || die "$CONFIG exists; change it with slack-relay config set, or rerun with --force"
  mkdir -p "$(dirname "$CONFIG")"
  jq -n --argjson d "$DEFAULTS" --arg c "$channel" --arg u "$user" --arg n "$name" --arg t "$token_file" --arg k "$cookie_file" \
    '$d | .channel = $c | .user = $u | .name = $n
       | if $t != "" then .slack.token_file = $t else . end
       | if $k != "" then .slack.cookie_file = $k else . end' >"$CONFIG"
  echo "wrote $CONFIG"
  if [[ -z "$user" ]] && user=$(slackc whoami 2>/dev/null) && [[ -n "$user" ]]; then
    command_config set user "$user" >/dev/null
    echo "user = $user (from the Slack token)"
  fi
  local errors
  errors=$(config_errors)
  [[ -z "$errors" ]] || { echo "still to set:"; sed 's/^/  /' <<<"$errors"; }
}

key_path() {
  [[ "$1" =~ ^[a-z_]+(\.[A-Za-z0-9_-]+)*$ ]] || die "key must look like dispatcher.models.claude"
  jq -nc --arg k "$1" '$k | split(".")'
}

command_config() {
  local action=${1:-show} key path value json tmp errors
  case "$action" in
    path) echo "$CONFIG" ;;
    schema) cat "$SCHEMA" ;;
    fields)
      # every setting in schema order with its current value, for a settings form
      [[ "${2:-}" == --json ]] || { usage >&2; exit 2; }
      jq --argjson c "$(config_json)" '
        def kind: if .type == "object" then (if .additionalProperties.type == "string" then "map" else "json" end) else .type end;
        def fields($p): to_entries[] | .key as $k | .value as $s | ($p + [$k]) as $path
          | if $s.type == "object" and $s.properties != null then $s.properties | fields($path)
            else {key: ($path | join(".")), group: (if ($path | length) > 1 then $path[0] else "general" end),
                  title: ($s.title // $k), description: ($s.description // ""), type: ($s | kind),
                  enum: $s.enum, value: ($c | getpath($path))} end;
        .properties as $props
        | {groups: ([{key: "general", title: "General", description: ""}]
            + [$props | to_entries[] | select(.value.type == "object" and .value.properties != null)
               | {key, title: (.value.title // .key), description: (.value.description // "")}]),
           fields: [$props | del(.connectors) | fields([])]}' "$SCHEMA"
      ;;
    show) config_json | jq . ;;
    get)
      [[ $# -eq 2 ]] || { usage >&2; exit 2; }
      path=$(key_path "$2")
      config_json | jq -r --argjson p "$path" 'getpath($p) | if type == "string" then . else tojson end'
      ;;
    set|unset)
      [[ ( "$action" == set && $# -eq 3 ) || ( "$action" == unset && $# -eq 2 ) ]] || { usage >&2; exit 2; }
      key=$2
      path=$(key_path "$key")
      mkdir -p "$(dirname "$CONFIG")"
      [[ -e "$CONFIG" ]] || echo '{}' >"$CONFIG"
      tmp=$(mktemp "$CONFIG.XXXXXX")
      if [[ "$action" == set ]]; then
        value=$3
        [[ "$key" != channel ]] || value=$(normalize_channel "$value")
        # JSON when it parses (true, 200, ["ADE"]), text otherwise
        # (not jq -e: it fails on false and null)
        json=$(jq -c . 2>/dev/null <<<"$value") && [[ -n "$json" && "$json" != *$'\n'* ]] && value=$json || value=$(jq -nc --arg v "$value" '$v')
        jq --argjson p "$path" --argjson v "$value" 'setpath($p; $v)' "$CONFIG" >"$tmp"
      else
        jq --argjson p "$path" 'delpaths([$p])' "$CONFIG" >"$tmp"
      fi
      errors=$(CONFIG=$tmp config_errors | grep -E "^${key//./\\.}[:.]" || true)
      if [[ -n "$errors" ]]; then
        rm -f "$tmp"
        die "not saved: $errors"
      fi
      mv "$tmp" "$CONFIG"
      echo "$key = $(command_config get "$key")"
      ;;
    apply)
      # {"set": {key: value}, "unset": [key]} on stdin, saved together or not at all; an app's
      # Save button uses it so settings that depend on each other (trigger and icons) change at once
      [[ $# -eq 1 ]] || { usage >&2; exit 2; }
      local patch before
      patch=$(jq -c 'select(type == "object") | {set: (.set // {}), unset: (.unset // [])}' 2>/dev/null) && [[ -n "$patch" ]] \
        || die "apply reads {\"set\": {key: value}, \"unset\": [key]} on stdin"
      while IFS= read -r key; do key_path "$key" >/dev/null; done < <(jq -r '(.set | keys[]), .unset[]' <<<"$patch")
      value=$(jq -r '.set.channel // empty | strings' <<<"$patch")
      [[ -z "$value" ]] || patch=$(jq -c --arg c "$(normalize_channel "$value")" '.set.channel = $c' <<<"$patch")
      mkdir -p "$(dirname "$CONFIG")"
      [[ -e "$CONFIG" ]] || echo '{}' >"$CONFIG"
      tmp=$(mktemp "$CONFIG.XXXXXX")
      jq --argjson p "$patch" 'reduce ($p.unset[] | split(".")) as $k (.; delpaths([$k]))
        | reduce ($p.set | to_entries[]) as $e (.; setpath($e.key | split("."); $e.value))' "$CONFIG" >"$tmp"
      # only errors this patch adds block it, so an old mistake elsewhere can still be fixed in steps
      before=$(config_errors)
      errors=$(CONFIG=$tmp config_errors | grep -vxF -f <(printf '%s\n' "$before") || true)
      if [[ -n "$errors" ]]; then
        rm -f "$tmp"
        echo "$errors"
        exit 1
      fi
      mv "$tmp" "$CONFIG"
      echo "saved $(jq '(.set | length) + (.unset | length)' <<<"$patch") setting(s)"
      ;;
    validate)
      errors=$(config_errors)
      [[ -z "$errors" ]] || { echo "$errors"; exit 1; }
      echo "config ok: $CONFIG"
      ;;
    *) usage >&2; exit 2 ;;
  esac
}

serve_json() {
  local file="$STATE/serve.json" pid
  [[ -f "$file" ]] || { echo '{"running": false}'; return; }
  pid=$(jq -r '.pid // 0' "$file")
  # a serve that died without cleanup leaves its pid behind, and macOS reuses pids
  if kill -0 "$pid" 2>/dev/null && [[ "$(ps -o command= -p "$pid" 2>/dev/null)" == *slack-relay*serve* ]]; then
    jq -c '. + {running: true}' "$file"
  else
    jq -c '. + {running: false}' "$file"
  fi
}

command_doctor() {
  local json=false checks="[]" runner dir name
  [[ "${1:-}" != --json ]] || json=true
  check() { checks=$(jq -c --arg c "$1" --argjson ok "$2" --arg d "$3" '. + [{check: $c, ok: $ok, detail: $d}]' <<<"$checks"); }
  for tool in curl jq perl; do
    if command -v "$tool" >/dev/null; then check "$tool installed" true "$(command -v "$tool")"; else check "$tool installed" false "not on PATH"; fi
  done
  if [[ -r "$CONFIG" ]]; then check "config file" true "$CONFIG"; else check "config file" false "missing; run: slack-relay init"; fi
  local errors
  errors=$(config_errors)
  if [[ -z "$errors" ]]; then check "config valid" true ""; else check "config valid" false "$(paste -sd ';' - <<<"$errors")"; fi
  if config_json | jq -e '.dispatcher | has("model")' >/dev/null; then
    check "dispatcher model" false "dispatcher.model is no longer read; set dispatcher.models.<runner>, then: slack-relay config unset dispatcher.model"
  fi
  local owner
  if owner=$(slackc whoami 2>&1); then
    if [[ "$owner" == "$ME" ]]; then check "slack login" true "token belongs to $owner"
    else check "slack login" false "token belongs to $owner, not the configured user ${ME:-(unset)}"; fi
  else
    check "slack login" false "$owner"
  fi
  local id
  for id in $(channels); do
    if slackc history "$id" 1 >/dev/null 2>&1; then check "channel readable" true "$id"
    else check "channel readable" false "cannot read channel $id"; fi
  done
  [[ -n "$(channels)" ]] || check "channel readable" false "no channel configured"
  for runner in $(printf '%s\n' "$(cfg .dispatcher.runner)" "$(cfg .worker.runner)" | sort -u); do
    if command -v "$runner" >/dev/null; then check "$runner installed" true "$(command -v "$runner")"; else check "$runner installed" false "runner $runner not on PATH"; fi
  done
  while IFS=$'\t' read -r name dir; do
    [[ -n "$name" ]] || continue
    dir=$(expand_path "$dir")
    if [[ -d "$dir" ]]; then check "repo $name" true "$dir"; else check "repo $name" false "missing folder $dir"; fi
  done < <(config_json | jq -r '.repos | to_entries[] | [.key, .value] | @tsv')
  if [[ "$(serve_json | jq -r .running)" == true ]]; then
    check "serve" true "running, pid $(serve_json | jq -r .pid)"
  else
    check "serve" true "not running; start with: slack-relay serve"
  fi
  if [[ "$json" == true ]]; then
    jq . <<<"$checks"
  else
    jq -r '.[] | "\(if .ok then "ok  " else "FAIL" end)  \(.check)\(if .detail == "" then "" else ": \(.detail)" end)"' <<<"$checks"
  fi
  [[ "$(jq '[.[] | select(.ok | not)] | length' <<<"$checks")" == 0 ]]
}

command_status_json() {
  local file name status last workers="[]" turns="[]" turn
  shopt -s nullglob
  for file in "$STATE"/workers/*.json; do
    name=$(basename "$file" .json)
    status=$(worker_status "$name")
    last=""
    [[ "$status" != running && "$status" != waiting ]] || last=$(last_activity "$STATE/workers/$name.events")
    workers=$(jq -c --slurpfile w "$file" --arg s "$status" --arg log "$STATE/workers/$name.log" \
      --arg e "$STATE/workers/$name.events" --argjson last "${last:-null}" \
      '. + [$w[0] + {status: $s, log: $log, events: $e, last: $last}]' <<<"$workers")
  done
  while IFS= read -r turn; do
    last=""
    [[ "$(jq -r .status <<<"$turn")" != running ]] || last=$(last_activity "$(jq -r .events <<<"$turn")")
    turns=$(jq -c --argjson t "$turn" --argjson last "${last:-null}" '. + [$t + {last: $last}]' <<<"$turns")
  done < <(dispatch_records)
  jq -n --argjson serve "$(serve_json)" --argjson workers "$workers" --argjson turns "$turns" --argjson config "$(config_json)" \
    --arg workdir "$(expand_path "$(cfg .dispatcher.workdir)")" \
    --arg cfile "$CONFIG" --arg state "$STATE" '{
      serve: $serve,
      dispatcher: ($config.dispatcher | {label, runner, model: ($config | '"$DISPATCHER_MODEL"'), workdir: $workdir, memory: "\($workdir)/MEMORY.md"}),
      turns: $turns,
      workers: $workers,
      paths: {config: $cfile, state: $state, serve_log: "\($state)/serve.log"}
    }'
}

# The activity file of a worker or a dispatcher turn ID, or nothing.
events_file() {
  if [[ "$1" =~ ^[0-9]+-[0-9]+$ && -f "$(turn_file "$1")" ]]; then
    printf '%s' "$STATE/dispatch/$1.events"
  elif [[ "$1" =~ ^[A-Za-z0-9_-]+$ && -f "$(worker_file "$1")" ]]; then
    printf '%s' "$STATE/workers/$1.events"
  fi
}

# activity <worker|turn> [--json] [--limit N]: what the agent did so far, newest last.
command_activity() {
  local target=${1:-} json=false limit=200 file
  [[ -n "$target" ]] || { usage >&2; exit 2; }
  shift
  while (( $# )); do
    case "$1" in
      --json) json=true; shift ;;
      --limit) [[ "${2:-}" =~ ^[0-9]+$ ]] || die "--limit needs a number"; limit=$2; shift 2 ;;
      *) usage >&2; exit 2 ;;
    esac
  done
  file=$(events_file "$target")
  [[ -n "$file" ]] || die "no worker or dispatcher turn named $target"
  if [[ "$json" == true ]]; then
    { [[ ! -f "$file" ]] || activity_rows <"$file"; } | tail -n "$limit" | jq -sc .
  else
    { [[ ! -f "$file" ]] || activity_rows <"$file"; } | tail -n "$limit" | jq -r '"\(.kind)\t\(.text)"'
  fi
}

# cancel <worker|turn>...: stops it the way "!<name> stop" does, and says so in Slack.
command_cancel() {
  [[ $# -ge 1 ]] || { usage >&2; exit 2; }
  local target turn status
  for target in "$@"; do
    if [[ "$target" =~ ^[0-9]+-[0-9]+$ && -f "$(turn_file "$target")" ]]; then
      turn=$(dispatch_records | jq -c --arg i "$target" 'select(.id == $i)')
      [[ "$(jq -r .status <<<"$turn")" == running ]] || { echo "$target is not running"; continue; }
      stop_turn "$turn" "$(jq -r '.label // empty' <<<"$turn" | grep . || cfg .dispatcher.label)" 2>/dev/null
      echo "stopped $target"
    else
      check_label "$target"
      status=$(worker_status "$target")
      [[ "$status" != none ]] || die "no worker or dispatcher turn named $target"
      [[ "$status" == running || "$status" == waiting ]] || { echo "$target is not running"; continue; }
      stop_worker "$target" 2>/dev/null
      echo "stopped $target"
    fi
  done
}

serve_update() {
  local file="$STATE/serve.json"
  [[ -f "$file" ]] || return 0
  # never replace it with nothing: an empty serve.json hides the running pid and lets a second serve start
  jq "$@" "$file" >"$file.tmp" </dev/null && [[ -s "$file.tmp" ]] && mv "$file.tmp" "$file"
}

# with_timeout <seconds> <command…>: SIGALRM ends the command when it takes longer.
with_timeout() {
  perl -e '$t = shift; alarm $t; exec @ARGV or exit 127' "$@"
}

# One row per agent CLI, whether or not the config uses it.
agents_json() {
  local runner path version rows="[]" workers
  workers=$(command_status_json | jq -c '.workers')
  for runner in opencode claude pi; do
    path=$(command -v "$runner" || true)
    version=""
    [[ -z "$path" ]] || version=$(with_timeout 10 "$runner" --version 2>/dev/null </dev/null | head -n 1 || true)
    rows=$(jq -c --arg r "$runner" --arg p "$path" --arg v "$version" --argjson c "$(config_json)" --argjson w "$workers" '. + [{
      name: $r, installed: ($p != ""), path: $p, version: $v,
      dispatcher: ($c.dispatcher.runner == $r), default_worker: ($c.worker.runner == $r),
      dispatcher_model: (if $c.dispatcher.runner == $r then ($c | '"$DISPATCHER_MODEL"') else null end),
      worker_model: ($c.worker.models[$r] // ""),
      active: [$w[] | select(.runner == $r and (.status == "running" or .status == "waiting"))] | length
    }]' <<<"$rows")
  done
  printf '%s' "$rows"
}

command_agents() {
  if [[ "${1:-}" == --json ]]; then agents_json | jq .; return; fi
  agents_json | jq -r '.[] | [.name, (if .installed then (.version // "") else "not installed" end),
    ([if .dispatcher then "dispatcher" else empty end, if .default_worker then "workers" else empty end] | join("+") | if . == "" then "-" else . end),
    "\(.active) active"] | @tsv'
}

# Model IDs an agent CLI accepts. claude can't list its models, so it gets its aliases.
models_for() {
  case "$1" in
    opencode) opencode models 2>/dev/null || true ;;
    pi) pi --list-models 2>/dev/null | awk 'NR > 1 && NF >= 2 { print $1 "/" $2 }' || true ;;
    claude) printf '%s\n' haiku sonnet opus ;;
    *) die "unknown runner $1 (use opencode, claude, or pi)" ;;
  esac
}

command_models() {
  local json=false runner rows='{}'
  [[ "${1:-}" != --json ]] || { json=true; shift; }
  (( $# )) || set -- opencode claude pi
  for runner in "$@"; do
    rows=$(models_for "$runner" | jq -Rsc --argjson r "$rows" --arg n "$runner" '$r + {($n): (split("\n") | map(select(. != "")))}')
  done
  if [[ "$json" == true ]]; then jq . <<<"$rows"; else jq -r 'to_entries[] | .key as $r | .value[] | "\($r)\t\(.)"' <<<"$rows"; fi
}

# First useful line a check printed, without anything that looks like a token.
connector_detail() {
  local out=$1 err=$2 line
  line=$(grep -m1 -v '^[[:space:]]*$' "$out" || true)
  [[ -n "$line" ]] || line=$(grep -v '^[[:space:]]*$' "$err" | grep -v '"class":"hint"' | tail -n 1 || true)
  line=$(jq -r 'if type == "object" and .error then (.error.details // .error.summary | tostring | split("\n")[0]) elif type == "string" then . else tojson end' <<<"$line" 2>/dev/null || printf '%s' "$line")
  sed -E -e 's/^[[:space:]]+//' -e 's/[A-Za-z0-9_+=-]{32,}/…/g' <<<"$line" | cut -c1-200
}

# The built-in slack connector: the token is the configured user's and every channel reads.
slack_check() {
  local owner id n=0
  owner=$(slackc whoami 2>&1) || { printf '%s\n' "$owner"; return 1; }
  [[ "$owner" == "$ME" ]] || { echo "token belongs to $owner, not the configured user ${ME:-(unset)}"; return 1; }
  for id in $(channels); do
    slackc history "$id" 1 >/dev/null 2>&1 || { echo "signed in as $owner, but cannot read channel $id"; return 1; }
    n=$((n + 1))
  done
  (( n )) || { echo "signed in as $owner, but no channel is configured"; return 1; }
  echo "signed in as $owner, $n channel$( (( n == 1 )) || echo s) readable"
}

connectors_json() {
  local dir entry name tool rows="[]"
  dir=$(mktemp -d "${TMPDIR:-/tmp}/slack-relay-connectors.XXXXXX")
  local -a names=()
  local slack=false
  if (( $# == 0 )) || [[ " $* " == *" slack "* ]]; then
    slack=true
    # each Slack call has its own curl timeout
    ( set +e; slack_check >"$dir/slack.out" 2>"$dir/slack.err" </dev/null; echo $? >"$dir/slack.code" ) &
  fi
  while IFS= read -r entry; do
    name=$(jq -r .name <<<"$entry")
    [[ "$name" != slack ]] || continue
    (( $# == 0 )) || [[ " $* " == *" $name "* ]] || continue
    names+=("$name")
    jq -r .check <<<"$entry" >"$dir/$name.check"
    [[ -s "$dir/$name.check" && "$(cat "$dir/$name.check")" != "" ]] || continue
    tool=$(awk '{print $1; exit}' "$dir/$name.check")
    if ! command -v "$tool" >/dev/null; then
      echo 127 >"$dir/$name.code"; echo "$tool not installed" >"$dir/$name.out"; : >"$dir/$name.err"
      continue
    fi
    ( set +e; with_timeout 20 bash -o pipefail -c "$(cat "$dir/$name.check")" >"$dir/$name.out" 2>"$dir/$name.err" </dev/null
      echo $? >"$dir/$name.code" ) &
  done < <(config_json | jq -c '.connectors // {} | to_entries[] | {name: .key, check: (.value.check // "")}')
  wait
  if [[ "$slack" == true ]]; then
    local code detail
    code=$(cat "$dir/slack.code" 2>/dev/null || echo 1)
    detail=$(connector_detail "$dir/slack.out" "$dir/slack.err")
    rows=$(jq -c --arg code "$code" --arg d "$detail" '. + [{name: "slack", title: "Slack", check: "", builtin: true, ok: ($code == "0"), detail: $d}]' <<<"$rows")
  fi
  for name in "${names[@]}"; do
    local code="" detail="" check
    check=$(cat "$dir/$name.check")
    if [[ -n "$check" ]]; then
      code=$(cat "$dir/$name.code" 2>/dev/null || echo 1)
      detail=$(connector_detail "$dir/$name.out" "$dir/$name.err")
      [[ -n "$detail" || "$code" == 0 ]] || detail="check failed (exit $code)"
      [[ "$code" != 142 ]] || detail="no answer after 20s"
    fi
    rows=$(jq -c --arg n "$name" --arg c "$check" --arg code "$code" --arg d "$detail" --argjson cfg "$(config_json)" '. + [{
      name: $n, title: ($cfg.connectors[$n].title // $n), check: $c,
      ok: (if $c == "" then null else $code == "0" end), detail: (if $c == "" then "off" else $d end)
    }]' <<<"$rows")
  done
  rm -rf "$dir"
  printf '%s' "$rows"
}

command_connectors() {
  local json=false rows
  [[ "${1:-}" != --json ]] || { json=true; shift; }
  rows=$(connectors_json "$@")
  if [[ "$json" == true ]]; then
    jq . <<<"$rows"
  else
    jq -r '.[] | "\(if .ok == null then "off " elif .ok then "ok  " else "FAIL" end)  \(.name): \(.detail)"' <<<"$rows"
  fi
  [[ "$(jq '[.[] | select(.ok == false)] | length' <<<"$rows")" == 0 ]]
}

# Each configured channel with its Slack name ("@handle" for a DM), null when Slack won't tell.
command_channels() {
  local id name rows='[]'
  while IFS= read -r id; do
    name=$(slackc info "$id" 2>/dev/null) || name=""
    rows=$(jq -c --arg id "$id" --arg n "$name" '. + [{id: $id, name: (if $n == "" then null else $n end)}]' <<<"$rows")
  done < <(channels)
  if [[ "${1:-}" == --json ]]; then
    jq . <<<"$rows"
  else
    jq -r '.[] | "\(.id)  \(if .name == null then "(name unknown)" elif .name | startswith("@") then .name else "#" + .name end)"' <<<"$rows"
  fi
}

command_memory() {
  local file limit
  file="$(expand_path "$(cfg .dispatcher.workdir)")/MEMORY.md"
  limit=$(cfg .dispatcher.memory_lines)
  case "${1:-show}" in
    show) [[ ! -f "$file" ]] || cat "$file" ;;
    path) echo "$file" ;;
    --json)
      local text=""
      [[ ! -f "$file" ]] || text=$(cat "$file")
      jq -n --arg p "$file" --arg t "$text" --argjson l "$limit" --argjson e "$([[ -f "$file" ]] && echo true || echo false)" \
        '{path: $p, exists: $e, lines: ($t | if . == "" then 0 else split("\n") | length end), limit: $l, text: $t}'
      ;;
    set)
      # replaces MEMORY.md with stdin
      mkdir -p "$(dirname "$file")"
      local tmp; tmp=$(mktemp "$file.XXXXXX")
      cat >"$tmp" && mv "$tmp" "$file"
      echo "saved $file ($(wc -l <"$file" | tr -d ' ') lines)"
      ;;
    *) usage >&2; exit 2 ;;
  esac
}

# Starts serve in the background, logging to serve.log, and waits until it polls or fails.
command_start() {
  local pid log="$STATE/serve.log" n
  pid=$(serve_json | jq -r 'select(.running) | .pid')
  [[ -z "$pid" ]] || { echo "already running (pid $pid)"; return 0; }
  require_user
  mkdir -p "$STATE"
  nohup "$SELF" serve >>"$log" 2>&1 </dev/null &
  pid=$!
  disown "$pid" 2>/dev/null || true
  for n in $(seq 1 40); do
    if ! kill -0 "$pid" 2>/dev/null; then
      tail -n 5 "$log" >&2
      die "serve stopped; log: $log"
    fi
    [[ "$(serve_json | jq -r '.pid')" != "$pid" ]] || { echo "started serve (pid $pid), log: $log"; return 0; }
    sleep 0.25
  done
  echo "serve is starting (pid $pid), log: $log"
}

command_stop() {
  local pid n
  pid=$(serve_json | jq -r 'select(.running) | .pid')
  [[ -n "$pid" ]] || { echo "not running"; return 0; }
  kill -TERM "$pid"
  for n in $(seq 1 20); do
    kill -0 "$pid" 2>/dev/null || { echo "stopped serve (pid $pid)"; return 0; }
    sleep 0.25
  done
  die "serve (pid $pid) is still running"
}

case ${1:-} in
  init) shift; command_init "$@" ;;
  config) shift; command_config "$@" ;;
  doctor) shift; command_doctor "$@" ;;
  post) shift; command_post "$@" ;;
  ask) shift; require_user; command_ask "$@" ;;
  wait) shift; require_user; command_wait "$@" ;;
  serve) shift; require_user; command_serve "$@" ;;
  spawn) shift; command_spawn "$@" ;;
  remove) shift; command_remove "$@" ;;
  activity) shift; command_activity "$@" ;;
  cancel) shift; command_cancel "$@" ;;
  status) shift; if [[ "${1:-}" == --json ]]; then command_status_json; else command_status "$@"; fi ;;
  agents) shift; command_agents "$@" ;;
  models) shift; command_models "$@" ;;
  connectors) shift; command_connectors "$@" ;;
  channels) shift; command_channels "$@" ;;
  memory) shift; command_memory "$@" ;;
  start) shift; command_start ;;
  stop) shift; command_stop ;;
  _work) shift; command_work "$@" ;;
  _slack) shift; slackc "$@" ;;
  -v|--version|version) echo "slack-relay $VERSION" ;;
  -h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
